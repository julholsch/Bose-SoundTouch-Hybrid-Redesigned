r(--text);\r\n\r\n    outline: 2px solid var(--accent);\r\n  }\r\n}\r\n\r\n/* 7. DISABLED INPUTS (Global Safety) */\r\n\r\ninput:disabled,\r\nselect:disabled {\r\n  border-color: var(--border);\r\n\r\n  opacity: 0.5;\r\n\r\n  cursor: not-allowed;\r\n}\r\n\r\ninput:disabled + label {\r\n  color: var(--text-secondary);\r\n\r\n  opacity: 0.5;\r\n}\r\n\r\n\r\nbutton {\r\n  display: inline-flex;\r\n\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 8px;\r\n\r\n  background: transparent;\r\n\r\n  transition: scale .1s ease-out;\r\n\r\n  cursor: pointer;\r\n  scale: 1;\r\n\r\n  &:active:not(:disabled) {\r\n    transition: all .15s ease-out;\r\n    scale: .95;\r\n  }\r\n\r\n  &:disabled {\r\n    border-color: transparent;\r\n\r\n    opacity: .5;\r\n\r\n    cursor: not-allowed;\r\n    pointer-events: auto !important;\r\n  }\r\n}\r\n\r\n.btn-primary {\r\n  display: flex;\r\n\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 8px;\r\n\r\n  padding: 10px;\r\n\r\n  border: 1px solid transparent;\r\n\r\n  border-radius: 6px;\r\n\r\n  font-weight: bold;\r\n\r\n  color: var(--btn-text-clr);\r\n\r\n  background-color: var(--btn-bg-clr);\r\n  scale: 1;\r\n  cursor: pointer;\r\n  transition: color .15s ease-out,\r\n  border .15s ease-out,\r\n  background-color .15s ease-out,\r\n  scale .1s ease-out;\r\n\r\n  img {\r\n    width: auto;\r\n\r\n    height: 16px;\r\n  }\r\n\r\n  &:hover {\r\n    transition: all .15s ease-out;\r\n    background-color: var(--btn-bg);\r\n    color: var(--btn-bg-clr);\r\n    border: 1px solid var(--btn-bg-clr);\r\n  }\r\n\r\n  &:active {\r\n    scale: .95;\r\n    transition: all .15s ease-out;\r\n  }\r\n}\r\n\r\n.btn-secondary {\r\n  padding: 6px 12px;\r\n\r\n  border: 1px solid var(--btn-border);\r\n\r\n  border-radius: 6px;\r\n  font-size: 0.85em;\r\n\r\n  font-weight: bold;\r\n\r\n  color: var(--btn-text);\r\n  background: var(--btn-bg);\r\n\r\n  &:hover {\r\n    border-color: var(--accent);\r\n\r\n    background: var(--btn-hover-bg);\r\n  }\r\n}\r\n\r\n.btn-sm {\r\n  padding: 4px 8px;\r\n\r\n  border: 1px solid var(--btn-border);\r\n\r\n  border-radius: 4px;\r\n  font-size: 0.75em;\r\n\r\n  color: var(--btn-text);\r\n  background: var(--btn-bg);\r\n\r\n  cursor: pointer;\r\n\r\n  &:hover {\r\n    border-color: var(--accent);\r\n\r\n    background: var(--btn-hover-bg);\r\n  }\r\n}\r\n\r\n\r\nbutton:disabled,\r\n.btn:disabled {\r\n  cursor: default !important;\r\n  pointer-events: none !important;\r\n}\r\n\r\n\r\n.app-header {\r\n  position: sticky;\r\n  top: 20px;\r\n  z-index: 999;\r\n\r\n  display: flex;\r\n\r\n  flex-direction: column;\r\n  gap: 10px;\r\n\r\n  padding: 0 0 2px 0;\r\n\r\n  pointer-events: none;\r\n  margin-bottom: 20px;\r\n\r\n  div {\r\n    pointer-events: auto;\r\n  }\r\n\r\n  &::after {\r\n    content: \"\";\r\n    position: absolute;\r\n    top: -20px;\r\n    left: -25px;\r\n    z-index: -1;\r\n\r\n    width: 100dvw;\r\n\r\n    height: calc(100% + 20px);\r\n\r\n    backdrop-filter: blur(15px);\r\n\r\n    /* Create the gradient fade */\r\n    -webkit-mask-image: linear-gradient(\r\n            to bottom,\r\n            rgba(0, 0, 0, 1) 80%,\r\n            rgba(0, 0, 0, 0) 100%\r\n    );\r\n    mask-image: linear-gradient(\r\n            to bottom,\r\n            rgba(0, 0, 0, 1) 80%,\r\n            rgba(0, 0, 0, 0) 100%\r\n    );\r\n  }\r\n}\r\n\r\n.header-inner-panel {\r\n\r\n  display: flex;\r\n\r\n  justify-content: space-between;\r\n  align-items: center;\r\n\r\n  box-sizing: unset;\r\n\r\n  height: 80px;\r\n  padding: 5px 25px;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 12px;\r\n\r\n  background: var(--card);\r\n\r\n  box-shadow: 0 4px 6px rgba(0,0,0,0.05);\r\n  backdrop-filter: blur(5px);\r\n}\r\n\r\n.app-logo {\r\n  display: flex;\r\n\r\n  flex-direction: row;\r\n  flex-wrap: nowrap;\r\n  align-items: center;\r\n  gap: 12px;\r\n\r\n  font-size: 1.1em;\r\n\r\n  font-weight: 700;\r\n  letter-spacing: 0.5px;\r\n\r\n  white-space: nowrap;\r\n\r\n  color: var(--title-color);\r\n\r\n  img {\r\n    width: auto;\r\n\r\n    height: 32px;\r\n  }\r\n}\r\n\r\n.global-link {\r\n  position: relative;\r\n  padding: 8px;\r\n  height: 100%;\r\n\r\n\r\n  display: flex;\r\n  flex-direction: column;\r\n\r\n  justify-content: center;\r\n  align-items: center;\r\n\r\n  gap: 0px;\r\n  border: 1px solid transparent;\r\n\r\n  border-radius: 6px;\r\n  font-size: 1.1em;\r\n\r\n  font-weight: 500;\r\n\r\n  text-align: center;\r\n  text-decoration: none;\r\n\r\n  color: var(--text-secondary);\r\n\r\n  transition: all 0.2s;\r\n\r\n  cursor: pointer;\r\n\r\n  &:hover {\r\n    color: var(--text);\r\n    background: var(--nav-hover);\r\n    .menu-icons {\r\n\r\n      fill: var(--accent);\r\n    }\r\n  }\r\n\r\n  &.active {\r\n    border-color: rgba(46, 204, 113, 0.2);\r\n\r\n    color: var(--accent);\r\n    background: rgba(46, 204, 113, 0.1);\r\n    .menu-icons {\r\n\r\n      fill: currentColor;\r\n    }\r\n\r\n    .menu-icons-label {\r\n      display: flex;\r\n    }\r\n  }\r\n  .menu-icons {\r\n    position: relative;\r\n    width: auto;\r\n    height: 3ch;\r\n    fill: var(--text);\r\n  }\r\n\r\n  .menu-icons-label {\r\n    text-align: center;\r\n    font-size: 1rem;\r\n    display: flex;\r\n  }\r\n}\r\n\r\n\r\n\r\n/*\r\n>> Card Header <<\r\n*/\r\n\r\n.card-header {\r\n  display: flex;\r\n\r\n  flex-direction: column;\r\n  justify-content: flex-start;\r\n  align-items: flex-start;\r\n  border-radius: 12px;\r\n  padding: 5px;\r\n\r\n  text-align: left;\r\n\r\n  &.toggable {\r\n    cursor: pointer;\r\n    user-select: none;\r\n\r\n    &:hover {\r\n      background-color: #fdf9ff2c;\r\n    }\r\n  }\r\n\r\n\r\n  &.speaker {\r\n    flex-direction: row;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n.card-heading-wrapper {\r\n  display: flex;\r\n\r\n  justify-content: space-between;\r\n  align-items: center;\r\n\r\n  width: 100%;\r\n\r\n  .log-chevron {\r\n    font-size: 1.2em;\r\n\r\n    color: var(--text-secondary);\r\n  }\r\n}\r\n\r\n.card-heading {\r\n  margin: 0 0 5px 0;\r\n}\r\n\r\n.card-sub-heading {\r\n  display: flex;\r\n\r\n  flex-wrap: wrap;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n\r\n  font-size: 0.85em;\r\n\r\n  color: var(--text-secondary);\r\n}\r\n\r\n\r\n/*\r\n>> Inner Panel <<\r\n*/\r\n\r\n.inner-panel {\r\n  display: flex;\r\n\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  align-items: stretch;\r\n  gap: 10px;\r\n\r\n  padding: 15px;\r\n\r\n  border: 1px solid var(--panel-border);\r\n\r\n  border-radius: 12px;\r\n\r\n  background: var(--panel-bg);\r\n\r\n  div {\r\n    flex-grow: 1;\r\n  }\r\n}\r\n\r\n/*.header-inner-panel {*/\r\n/*  display: flex;*/\r\n\r\n/*  justify-content: space-between;*/\r\n/*  align-items: center;*/\r\n\r\n/*  box-sizing: unset;*/\r\n\r\n/*  height: 50px;*/\r\n/*  padding: 5px 25px;*/\r\n\r\n/*  border: 1px solid var(--border);*/\r\n\r\n/*  border-radius: 12px;*/\r\n/*  margin-bottom: 20px;*/\r\n\r\n/*  background: var(--card);*/\r\n\r\n/*  box-shadow: 0 4px 6px rgba(0,0,0,0.05);*/\r\n/*  backdrop-filter: blur(5px);*/\r\n/*}*/\r\n\r\n.inner-panel-heading {\r\n  display: flex;\r\n\r\n  align-items: center;\r\n  align-self: flex-start;\r\n\r\n  font-weight: bold;\r\n\r\n  color: var(--text);\r\n  justify-self: flex-start;\r\n}\r\n\r\n.inner-panel-sub-heading {\r\n  margin-bottom: 10px;\r\n  font-size: 0.85em;\r\n\r\n  color: var(--text);\r\n\r\n  opacity: 0.8;\r\n}\r\n\r\n.badge-pill {\r\n  display: flex;\r\n\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 5px;\r\n\r\n  padding: 6px 12px;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 6px;\r\n  font-size: 0.85em;\r\n\r\n  font-weight: bold;\r\n  line-height: 1;\r\n\r\n  text-align: center;\r\n\r\n  color: var(--text);\r\n  background: var(--panel-bg);\r\n\r\n  img {\r\n    width: auto;\r\n\r\n    height: 10px;\r\n\r\n    opacity: 0.8;\r\n  }\r\n}\r\n\r\n.warning-box {\r\n  padding: 8px 10px;\r\n\r\n  border: 1px solid var(--danger);\r\n\r\n  border-left: 3px solid var(--danger);\r\n  border-radius: 12px;\r\n  margin: 10px 0;\r\n  font-size: 0.85em;\r\n\r\n  line-height: 1.3;\r\n\r\n  color: var(--text);\r\n  background: rgba(231, 76, 60, 0.1);\r\n}\r\n\r\n.warning-box-wrapper {\r\n  display: flex;\r\n\r\n  flex-direction: row;\r\n  justify-content: center;\r\n  align-items: stretch;\r\n  gap: 10px;\r\n\r\n  .warning-box {\r\n    flex-grow: 1;\r\n\r\n    label {\r\n      display: flex;\r\n\r\n      align-items: center;\r\n      gap: 6px;\r\n\r\n      margin-bottom: 8px;\r\n      font-size: 0.85em;\r\n\r\n      font-weight: bold;\r\n\r\n      color: var(--text);\r\n\r\n      cursor: pointer;\r\n    }\r\n\r\n    select {\r\n      width: 100%;\r\n\r\n      padding: 6px;\r\n\r\n      border: 1px solid #777;\r\n\r\n      border-radius: 4px;\r\n      font-size: 0.85em;\r\n\r\n      color: var(--text);\r\n      background: var(--bg-color);\r\n    }\r\n  }\r\n}\r\n\r\n[data-accordion] {\r\n  interpolate-size: allow-keywords;\r\n  gap: 0;\r\n  transition: gap .2s ease-in-out;\r\n  .inner-collapse-container {\r\n    visibility: hidden;\r\n    flex-direction: column;\r\n    height: 0px;\r\n    gap: 15px;\r\n    transition: all .2s ease-in-out;\r\n\r\n\r\n    .container-heading {\r\n      margin-bottom: 10px;\r\n\r\n      font-weight: bold;\r\n\r\n      color: var(--text);\r\n    }\r\n  }\r\n\r\n  .chevron {\r\n    transform: rotateZ(0);\r\n    transition: transform .2s ease-in-out;\r\n  }\r\n\r\n  &.open {\r\n    gap: 15px;\r\n    transition: gap .2s ease-in-out;\r\n    .inner-collapse-container {\r\n      visibility: visible;\r\n      transition: all .2s ease-in-out;\r\n      height: max-content;\r\n      gap: 0;\r\n\r\n      .container-heading {\r\n        margin-bottom: 0;\r\n      }\r\n    }\r\n\r\n    .chevron {\r\n      transform: rotateZ(180deg);\r\n      transition: transform .3s ease-in-out;\r\n    }\r\n  }\r\n}\r\n\r\n.active-pairs-wrapper {\r\n  ul {\r\n    overflow: hidden;\r\n\r\n    padding: 0;\r\n\r\n    border: 1px solid var(--border);\r\n\r\n    border-radius: 6px;\r\n    margin-bottom: 20px;\r\n\r\n    list-style: none;\r\n  }\r\n\r\n  .no-active-pair-li-element {\r\n    padding: 10px;\r\n\r\n    font-style: italic;\r\n\r\n    color: var(--text-secondary);\r\n    background: var(--input-bg);\r\n  }\r\n\r\n  .active-pairs-li-element {\r\n    display: flex;\r\n\r\n    justify-content: space-between;\r\n    align-items: center;\r\n\r\n    padding: 12px;\r\n\r\n    border-bottom: 1px solid var(--border);\r\n\r\n    background: var(--card);\r\n\r\n    strong {\r\n      font-size: 1.1em;\r\n\r\n      color: var(--text);\r\n    }\r\n\r\n    small {\r\n      color: var(--text-secondary);\r\n    }\r\n\r\n    button {\r\n      border: none;\r\n\r\n      color: white;\r\n      background: var(--danger);\r\n\r\n      cursor: pointer;\r\n    }\r\n  }\r\n\r\n}\r\n.tool-info-badge {\r\n  padding: 4px 8px;\r\n  margin-right: auto;\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 4px;\r\n  font-family: monospace;\r\n  font-size: 0.9em;\r\n\r\n  background: var(--input-bg);\r\n}\r\n\r\n.pairing-setup-wrapper {\r\n  display: flex;\r\n\r\n  flex-direction: row;\r\n  flex-wrap: wrap;\r\n  justify-content: stretch;\r\n  align-items: flex-end;\r\n  gap: 10px;\r\n\r\n  .pairing-setup-column {\r\n    flex-grow: 1;\r\n\r\n    min-width: 200px;\r\n\r\n    label {\r\n      display: block;\r\n\r\n      font-size: 0.75em;\r\n\r\n      color: var(--text-secondary);\r\n    }\r\n\r\n    select,\r\n    input {\r\n      width: 100%;\r\n\r\n      height: 40px;\r\n      padding: 0 10px;\r\n\r\n      border: 1px solid var(--border);\r\n\r\n      border-radius: 6px;\r\n\r\n      color: var(--input-text);\r\n      background: var(--input-bg);\r\n    }\r\n  }\r\n}\r\n\r\n.btn-in-columns {\r\n  display: flex;\r\n  flex-direction: row;\r\n  gap: 12px;\r\n  align-self: center;\r\n}\r\n\r\n/* ==========
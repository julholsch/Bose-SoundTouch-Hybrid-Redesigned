ive;\r\n  flex-grow: 1;\r\n  gap: 10px;\r\n  display: flex;\r\n  width: 40%;\r\n  height: 100%;\r\n  flex-direction: row;\r\n  justify-content: flex-start;\r\n  align-items: center;\r\n\r\n  &:has(.np-controls) {\r\n    justify-content: center;\r\n    width: 20%;\r\n    gap: 5px;\r\n    flex-direction: column;\r\n    align-items: center;\r\n  }\r\n}\r\n\r\n.np-art {\r\n  position: relative;\r\n\r\n  display: flex;\r\n  \r\n  overflow: hidden;\r\n\r\n  width: 100px;\r\n\r\n  height: 100px;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 12px;\r\n\r\n  background: var(--art-bg);\r\n\r\n  box-shadow: 0 0 15px rgba(0,0,0,0.5);\r\n\r\n  object-fit: cover;\r\n\r\n  img {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    z-index: 10;\r\n\r\n    width: 100%;\r\n\r\n    height: 100%;\r\n\r\n    object-fit: cover;\r\n  }\r\n}\r\n\r\n\r\n\r\n.art {\r\n  position: relative;\r\n\r\n  overflow: hidden;\r\n\r\n  width: 60px;\r\n\r\n  height: 60px;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 4px;\r\n\r\n  background: var(--art-bg);\r\n\r\n  object-fit: cover;\r\n\r\n  img {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    z-index: 10;\r\n\r\n    width: 100%;\r\n\r\n    height: 100%;\r\n\r\n    object-fit: cover;\r\n  }\r\n}\r\n\r\n/* ART Placeholders*/\r\n\r\n.art-blank,\r\n.art-globe,\r\n.art-off {\r\n  display: flex;\r\n\r\n  justify-content: center;\r\n  align-items: center;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  background-color: var(--art-bg);\r\n\r\n  &.np-art {\r\n    font-size: 80px;\r\n  }\r\n\r\n  &.art {\r\n    font-size: 40px;\r\n  }\r\n}\r\n\r\n.art-blank::after,\r\n.art-globe::after,\r\n.art-off::after {\r\n  color: var(--text);\r\n  opacity: 0.4;\r\n}\r\n\r\n.art-blank::after {\r\n  content: \"\";\r\n}\r\n\r\n.art-globe::after {\r\n  content: \"\uD83C\uDF10\";\r\n}\r\n\r\n.art-off::after {\r\n  content: url(\"/images/svg/PowerOff.svg\");\r\n  color: red;\r\n  stroke: currentColor;\r\n  padding: 5px;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  /*translate: 0 -10px;*/\r\n  z-index: 10;\r\n\r\n  width: 100%;\r\n\r\n  height: 100%;\r\n\r\n  object-fit: cover;\r\n}\r\n\r\n.np-progress-timer-wrapper {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  white-space: nowrap;\r\n  width: 100%;\r\n}\r\n\r\n.np-timer {\r\n  font-size: 1.2rem;\r\n\r\n  text-align: left;\r\n}\r\n\r\n.np-progress {\r\n  width: 100%;\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  border-radius: 20px;\r\n  overflow: hidden;\r\n  border: none;\r\n\r\n  background-color: var(--btn-bg);\r\n\r\n  &[value]::-webkit-progress-bar\r\n  {\r\n    background-color: var(--btn-bg);\r\n  }\r\n\r\n  &[value]::-moz-progress-bar {\r\n\r\n    background-color: var(--accent);\r\n  }\r\n\r\n  &[value]::-webkit-progress-value{\r\n    background-color: var(--accent);\r\n  }\r\n}\r\n\r\n.np-infos {\r\n  display: flex;\r\n  /*max-width: ;*/\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n}\r\n\r\n.np-track {\r\n  font-size: 1.6em;\r\n\r\n  font-weight: bold;\r\n  line-height: 1.2;\r\n\r\n  text-align: left;\r\n\r\n  color: var(--text);\r\n}\r\n\r\n.np-artist {\r\n  font-size: 1.2em;\r\n\r\n  text-align: left;\r\n\r\n  color: var(--accent);\r\n}\r\n\r\n.np-album {\r\n  font-size: 1em;\r\n\r\n  font-style: italic;\r\n\r\n  text-align: left;\r\n\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.np-controls-wrapper {\r\n  display: flex;\r\n  flex-direction: row;\r\n  gap: 5px;\r\n  align-items: center;\r\n  --controls-size: 50px;\r\n  --controls-icon-scale: 1.2;\r\n\r\n  .control-icon {\r\n\r\n    scale: var(--controls-icon-scale);\r\n    fill: white;\r\n    width: var(--controls-size);\r\n    height: var(--controls-size);\r\n    &:hover {\r\n      fill: var(--accent);\r\n    }\r\n  }\r\n\r\n  .play {\r\n    --controls-size: 60px;\r\n    --controls-icon-scale: 1.4;\r\n  }\r\n\r\n  .np-controls {\r\n    border-radius: 50%;\r\n    
e-between;\r\n  align-items: center;\r\n\r\n  padding: 20px;\r\n  padding-bottom: 10px;\r\n\r\n  border-radius: 12px;\r\n\r\n  background-color: transparent;\r\n\r\n  &:after {\r\n    content: \"\";\r\n    position: absolute;\r\n    top: -5px;\r\n    left: 0;\r\n    z-index: -1;\r\n\r\n    width: 100%;\r\n\r\n    height: calc(100% + 5px);\r\n\r\n    backdrop-filter: blur(15px);\r\n\r\n    /* Create the gradient fade */\r\n    -webkit-mask-image: linear-gradient(\r\n                to bottom, \r\n                rgba(0, 0, 0, 1) 10%,\r\n                rgba(0, 0, 0, .75) 80%,\r\n                rgba(0, 0, 0, 0) 100%\r\n            );\r\n    mask-image: linear-gradient(\r\n                to bottom, \r\n                rgba(0, 0, 0, 1) 10%,\r\n                rgba(0, 0, 0, .75) 80%,\r\n                rgba(0, 0, 0, 0) 100%\r\n            );\r\n  }\r\n}\r\n\r\n.modal-content {\r\n  display: flex;\r\n\r\n  flex-direction: column;\r\n  gap: 10px;\r\n\r\n  padding: 20px;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 12px;\r\n\r\n  background: var(--card);\r\n\r\n  box-shadow: 0 10px 25px rgba(0,0,0,0.5);\r\n}\r\n\r\n.modal-close-btn {\r\n  border: none;\r\n\r\n  font-size: 1.5em;\r\n\r\n  color: var(--text);\r\n  background-color: var(--btn-bg);\r\n\r\n  opacity: 0.6;\r\n\r\n  transition: scale .2s ease-in-out;\r\n\r\n  cursor: pointer;\r\n  outline: 0 solid transparent;\r\n\r\n  &:hover {\r\n    transition: all .2s ease-in-out;\r\n\r\n    outline: 2px solid var(--accent);\r\n  }\r\n}\r\n\r\n.libary-title {\r\n  display: flex;\r\n\r\n  flex-wrap: wrap;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 12px;\r\n\r\n  width: 500px;\r\n\r\n  height: 100%;\r\n\r\n  font-size: 1.4em;\r\n\r\n  color: var(--title-color);\r\n\r\n  span {\r\n    margin-top: 4px;\r\n    font-size: 0.6em;\r\n\r\n    letter-spacing: 1px;\r\n\r\n    text-transform: uppercase;\r\n\r\n    color: #888;\r\n  }\r\n\r\n  img {\r\n    width: auto;\r\n\r\n    height: 28px;\r\n  }\r\n}\r\n\r\n\r\n\r\n.source-row {\r\n  display: flex;\r\n\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n\r\n  span {\r\n    font-size:1.2em;\r\n  }\r\n\r\n  img {\r\n    height:16px; width:auto; object-fit:contain;\r\n  }\r\n}\r\n\r\n.source-btn {\r\n  display: flex;\r\n\r\n  flex: 1;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 10px;\r\n\r\n  padding: 8px;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 6px;\r\n  font-size: 1.1em;\r\n\r\n  font-weight: bold;\r\n\r\n  color: var(--btn-text);\r\n  background: var(--btn-bg);\r\n\r\n  transition: all 0.2s;\r\n\r\n  cursor: pointer;\r\n}\r\n\r\n.source-btn img {\r\n  width: auto;\r\n\r\n  height: 28px;\r\n\r\n  border-radius: 4px;\r\n\r\n  transition: filter 0.2s;\r\n}\r\n\r\n.source-btn.active-spotify {\r\n  border-color: var(--accent);\r\n\r\n  color: black;\r\n  background: var(--accent);\r\n}\r\n\r\n.source-btn.active-spotify img {\r\n  filter: brightness(0);\r\n}\r\n\r\n.source-btn.active-radio {\r\n  border-color: var(--radio);\r\n\r\n  color: black;\r\n  background: var(--radio);\r\n}\r\n\r\n.source-btn.active-nas {\r\n  border-color: var(--nas);\r\n\r\n  color: black;\r\n  background: var(--nas);\r\n}\r\n\r\n.source-btn.active-nas img {\r\n  filter: brightness(0);\r\n}\r\n\r\n.source-btn.active-global {\r\n  border-color: #3498db;\r\n\r\n  color: black;\r\n  background: #3498db;\r\n}\r\n\r\n\r\n/* \r\n=========================================\r\n6. MOBILE RESPONSIVENESS\r\n========================================= \r\n*/\r\n\r\n@media screen and (max-width: 768px) {\r\n  #lib-presets .card {\r\n    overflow: hidden;\r\n\r\n    height: fit-content;\r\n    max-height: 100px;\r\n    padding: 15px;\r\n  }\r\n}\r\n

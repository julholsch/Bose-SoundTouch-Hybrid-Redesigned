<+>\r\n\r\n.app-content {\r\n  display: flex;\r\n\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.speaker-status-bar {\r\n  display: flex;\r\n\r\n  justify-content: center;\r\n\r\n  width: 100%;\r\n}\r\n\r\n.deep-scan-wrapper {\r\n  visibility: hidden;\r\n\r\n  height: 0px;\r\n  \r\n  margin-top: -10px;\r\n  transition: all .2s ease-in-out;\r\n\r\n  cursor: default;\r\n  interpolate-size: allow-keywords;\r\n\r\n  &.opend {\r\n    visibility: visible;\r\n    \r\n    transition: all .2s ease-in-out;\r\n    margin-top: 0;\r\n    cursor: text;\r\n    height: max-content;\r\n  }\r\n}\r\n\r\n.deep-scan-display {\r\n  display: block;\r\n\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n\r\n  height: 300px;\r\n  padding: 8px;\r\n\r\n  font-family: monospace;\r\n  font-size: 0.8em;\r\n\r\n  background: var(--input-bg);\r\n\r\n  resize: none;\r\n\r\n  /* Adapts to light/dark mode */\r\n  color: var(--console-text);\r\n\r\n  /* Adapts to light/dark mode */\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 12px;\r\n\r\n  line-height: 1.2;\r\n\r\n  white-space: pre-wrap;\r\n  word-wrap: break-word;\r\n\r\n  &:hover {\r\n    border: 1px solid var(--accent);\r\n  }\r\n}\r\n\r\n\r\n\r\n.global-nav-menu {\r\n  display: flex;\r\n\r\n  justify-content: center;\r\n  align-items: center;\r\n  align-self: center;\r\n  gap: 5px;\r\n}\r\n\r\n\r\n.card {\r\n  position: relative;\r\n\r\n  display: flex;\r\n  overflow: hidden;\r\n\r\n  flex-direction: column;\r\n  gap: 15px;\r\n\r\n  padding: 20px;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  border-radius: 16px;\r\n\r\n  background: var(--card);\r\n}\r\n\r\n.card-grid {\r\n  display: grid;\r\n\r\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\r\n  gap: 20px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n.icon-power {\r\n  display: inline-block;\r\n\r\n  width: 1.1em;\r\n\r\n  height: 1.1em;\r\n\r\n  font-size: 1.1em;\r\n\r\n  color: var(--off-clr);\r\n  background-color: currentColor;\r\n  -webkit-mask-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' stroke='black' stroke-width='2.5' fill='none' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M18.36 6.64a9 9 0 1 1-12.73 0'/%3E%3Cline x1='12' y1='2' x2='12' y2='12'/%3E%3C/svg%3E\");\r\n  mask-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' stroke='black' stroke-width='2.5' fill='none' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M18.36 6.64a9 9 0 1 1-12.73 0'/%3E%3Cline x1='12' y1='2' x2='12' y2='12'/%3E%3C/svg%3E\");\r\n  -webkit-mask-repeat: no-repeat;\r\n  mask-repeat: no-repeat;\r\n  -webkit-mask-position: center;\r\n  mask-position: center;\r\n  vertical-align: middle;\r\n}\r\n\r\n.speaker-grid {\r\n  display: grid;\r\n\r\n  align-items: start;\r\n  grid-template-columns: repeat(auto-fill, \r\n        minmax(340px, 1fr));\r\n  gap: 15px;\r\n}\r\n\r\n\r\n\r\n\r\n.info-row {\r\n  display: flex;\r\n\r\n  flex-direction: column;\r\n  gap: 5px;\r\n\r\n  font-family: -apple-system,\r\n               sans-serif;\r\n  font-size: 0.85em;\r\n\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.control-labels {\r\n  font-size: 0.9em;\r\n\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.control-row {\r\n  display: flex;\r\n\r\n  justify-content: space-between;\r\n  align-items: center;\r\n\r\n  padding: 4px 0;\r\n\r\n  .control-labels {\r\n    font-size: 0.9em;\r\n\r\n    color: var(--text-secondary);\r\n  }\r\n\r\n  &.control-row-slider {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 15px;\r\n  }\r\n\r\n  &.control-row-speaker-name {\r\n    gap: 5px;\r\n\r\n    height: 35px;\r\n  }\r\n}\r\n\r\ninput[type=\"text\"].rename-speaker {\r\n  height: 100%;\r\n  padding: 6px;\r\n\r\n  border: 2px solid #777;\r\n\r\n  border-radius: 6px;\r\n\r\n  color: var(--text);\r\n  background: var(--bg-color);\r\n}\r\n\r\n.tools-area {\r\n  display: flex;\r\n\r\n  justify-content: space-between;\r\n  align-items: center;\r\n\r\n  padding: 12px;\r\n\r\n  border: 1px solid var(--panel-border);\r\n\r\n  border-radius: 12px;\r\n\r\n  background: var(--panel-bg);\r\n}\r\n\r\n.speaker-firmware {\r\n  font-size: 0.75em;\r\n\r\n  line-height: 1.2;\r\n\r\n  color: var(--text);\r\n\r\n  opacity: 0.8;\r\n}\r\n\r\n/* --- FLOATING VOLUME BUBBLE --- */\r\n\r\n.vol-bubble {\r\n  position: absolute;\r\n  top: -50px;\r\n\r\n  /* Floats above the slider */\r\n  padding: 4px 8px;\r\n\r\n  border-radius: 4px;\r\n  font-size: 0.8em;\r\n\r\n  font-weight: bold;\r\n\r\n  color: #000;\r\n  background: var(--accent);\r\n\r\n  pointer-events: none;\r\n\r\n  /* Let clicks pass through */\r\n  opacity: 0;\r\n\r\n  /* Hidden by default */\r\n  transform: translateX(-50%);\r\n\r\n  /* Centers bubble on the handle */\r\n  z-index: 100;\r\n\r\n  white-space: nowrap;\r\n\r\n  box-shadow: 0 2px 5px rgba(0,0,0,0.5);\r\n\r\n  transition: none !important;\r\n  /* SNAPPY: No fading; */\r\n}\r\n\r\n/* Show bubble when active */\r\n\r\n.vol-bubble.visible {\r\n  opacity: 1;\r\n\r\n  -webkit-transform: translateX(-50%) scale(2.0);\r\n\r\n  /* iPhone specific */\r\n  transform: translateX(-50%) scale(2.0);\r\n}\r\n\r\n/* Triangle pointer at bottom of bubble */\r\n\r\n.vol-bubble::after {\r\n  content: '';\r\n  position: absolute;\r\n  bottom: -4px;\r\n  left: 50%;\r\n\r\n  border-width: 4px;\r\n  border-style: solid;\r\n  border-color: var(--accent) transparent transparent transparent;\r\n\r\n  margin-left: -4px;\r\n}\r\n\r\n.slider-header {\r\n  display: flex;\r\n\r\n  justify-content: space-between;\r\n\r\n  width: 100%;\r\n\r\n  span {\r\n    color: var(--text);\r\n\r\n    opacity: 0.8;\r\n  }\r\n}\r\n\r\n.slider-container {\r\n  position: relative;\r\n\r\n  display: flex;\r\n\r\n  flex-direction: row;\r\n  align-items: center;\r\n  gap: 10px;\r\n\r\n  width: 100%;\r\n}\r\n\r\ninput[type=range] {\r\n  flex-grow: 1;\r\n\r\n  width: 100%;\r\n\r\n  height: 6px;\r\n\r\n  border-radius: 2px;\r\n\r\n  background: #333
condary); margin-bottom:5px;\">PRESET</label>\r\n\t\t\t\t\t\t\t\t\t<select id=\"newPlayPreset\" style=\"background:var(--input-bg); color:var(--input-text); border:1px solid var(--border); padding:8px; border-radius:4px;\">\r\n\t\t\t\t\t\t\t\t\t\t<option value=\"1\">1</option>\r\n\t\t\t\t\t\t\t\t\t\t<option value=\"2\">2</option>\r\n\t\t\t\t\t\t\t\t\t\t<option value=\"3\">3</option>\r\n\t\t\t\t\t\t\t\t\t\t<option value=\"4\">4</option>\r\n\t\t\t\t\t\t\t\t\t\t<option value=\"5\">5</option>\r\n\t\t\t\t\t\t\t\t\t\t<option value=\"6\">6</option>\r\n\t\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t<label style=\"display:block; font-size:0.75em; color:var(--text-secondary); margin-bottom:5px;\">TIME</label>\r\n\t\t\t\t\t\t\t\t\t<div style=\"display:flex; gap:5px; align-items:center;\">\r\n\t\t\t\t\t\t\t\t\t\t<select id=\"newPlayHour\" style=\"background:var(--input-bg); color:var(--input-text); border:1px solid var(--border); padding:8px; border-radius:4px;\">\r\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\" disabled selected>HH</option>\r\n\t\t\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t\t\t\t<select id=\"newPlayMinute\" style=\"background:var(--input-bg); color:var(--input-text); border:1px solid var(--border); padding:8px; border-radius:4px;\">\r\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\" disabled selected>MM</option>\r\n\t\t\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t<button id=\"addScheduledPlayBtn\" class=\"btn-primary\" style=\"--btn-bg-clr: var(--card-border-accent-clr)\" onclick=\"addScheduledPlay()\">\r\n\t\t\t\t\t\t\t\t\t\t➕ Add\r\n\t\t\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</section>\r\n\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<div id=\"tab-services\" data-tab-name=\"services\" class=\"tools-subpage\" style=\"display:none; --card: var(--card-green-tint);\">\r\n\t\t\t\t<div class=\"tools\">\r\n\t\t\t\t\t<section id=\"system-services\" class=\"tool-cards card\" style=\"--card-border-accent-clr: #9b59b6;\">\r\n\t\t\t\t\t\t<div class=\"card-header\">\r\n\t\t\t\t\t\t\t<h3 class=\"card-heading\">⚙\uFE0F System Services</h3>\r\n\t\t\t\t\t\t\t<div class=\"card-sub-heading\">Manage container instances and hardware injections.</div>\r\n\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t<div class=\"card-grid\">\r\n\t\t\t\t\t\t\t<div class=\"inner-panel\" >\r\n\t\t\t\t\t\t\t\t<div class=\"inner-panel-heading\">SoundTouch Hybrid Application</div>\r\n\t\t\t\t\t\t\t\t<div class=\"inner-panel-sub-heading\">Restart the container or run a background speaker audit.</div>\r\n\r\n\t\t\t\t\t\t\t\t<div class=\"warning-box-wrapper\">\r\n\t\t\t\t\t\t\t\t\t<div class=\"warning-box\">\r\n\t\t\t\t\t\t\t\t\t\t<label>\r\n\t\t\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" id=\"forceInjectCheck\" onchange=\"document.getElementById('forceSpeakerSelect').disabled = !this.checked;\" class=\"pref-checkbox\" style=\"--accent: var(--card-border-accent-clr)\">\r\n\t\t\t\t\t\t\t\t\t\t\tForce Pre-Flight NVRAM\r\n\t\t\t\t\t\t\t\t\t\t</label>\r\n\t\t\t\t\t\t\t\t\t\t<select id=\"forceSpeakerSelect\" disabled>\r\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"all\">All Speakers</option>\r\n\t\t\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"warning-box\">\r\n\t\t\t\t\t\t\t\t\t\t<label>\r\n\t\t\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" id=\"forceRebootCheck\" onchange=\"document.getElementById('forceRebootSelect').disabled = !this.checked;\" class=\"pref-checkbox\" style=\"--accent: var(--card-border-accent-clr)\">\r\n\t\t\t\t\t\t\t\t\t\t\tForce Speaker Reboot\r\n\t\t\t\t\t\t\t\t\t\t</label>\r\n\t\t\t\t\t\t\t\t\t\t<select id=\"forceRebootSelect\" disabled>\r\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"all\">All Speakers</option>\r\n\t\t\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<button class=\"btn-primary\"  onclick=\"restartHybrid(this)\" style=\"--btn-bg-clr: var(--card-border-accent-clr)\";>\r\n\t\t\t\t\t\t\t\t\t<img src=\"images/hybrid_icon.png\" alt=\"Icon\">\r\n\t\t\t\t\t\t\t\t\tRestart SoundTouch Hybrid\r\n\t\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t\t\t<button class=\"btn-primary\" style=\"--btn-bg-clr: #3498db;\" onclick=\"triggerManualAudit()\">\r\n\t\t\t\t\t\t\t\t\t\uD83D\uDD0D Run Speaker Audit\r\n\t\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"inner-panel\" >\r\n\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t<div class=\"inner-panel-heading\">Music Assistant Server</div>\r\n\t\t\t\t\t\t\t\t\t<div class=\"inner-panel-sub-heading\">\r\n\t\t\t\t\t\t\t\t\t\tSend a non-destructive network ping, aggressively reload protocols (temporarily stops music), or restart the container.\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t<button class=\"btn-primary\" onclick=\"rescanMass(this)\" style=\"--btn-bg-clr: #f39c12;\">\r\n\t\t\t\t\t\t\t\t\t\uD83D\uDD04 Soft Rescan (Keep-Alive)\r\n\t\t\t\t\t\t\t\t</button>\r\n\r\n\t\t\t\t\t\t\t\t<button class=\"btn-primary\" onclick=\"aggressiveReloadMass(this)\" style=\"--btn-bg-clr: #d35400;\">\r\n\t\t\t\t\t\t\t\t\t\uD83D\uDEA8 Aggressive Reload (DLNA & AirPlay)\r\n\t\t\t\t\t\t\t\t</button>\r\n\r\n\t\t\t\t\t\t\t\t<button class=\"btn-primary\" onclick=\"restartMass(this)\" style=\"--btn-bg-clr:#e74c3c;\">\r\n\t\t\t\t\t\t\t\t\t<img src=\"images/ma_icon.png\" alt=\"MA\"> Restart MASS Container\r\n\t\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</section>\r\n\r\n\t\t\t\t\t<section id=\"server-log\" class=\"tool-cards card\" data-accordion=\"server-log\" style=\"--card-border-accent-clr: #e74c3c;\">\r\n\t\t\t\t\t\t<div class=\"card-header toggable\"  onclick=\"toggleAccordion('server-log')\">\r\n\t\t\t\t\t\t\t<div class=\"card-heading-wrapper\">\r\n\t\t\t\t\t\t\t\t<h3 class=\"card-heading\">\uD83D\uDDA5\uFE0F Live Server Logs</h3>\r\n\t\t\t\t\t\t\t\t<span id=\"log-chevron\" class=\"chevron\">▼</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"card-sub-heading\">Captures the last 350 console events from the Node.js server.</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div id=\"log-container\" class=\"inner-collapse-container\">\r\n\t\t\t\t\t\t\t<textarea id=\"live-log-viewer\" class=\"console-preview\" readonly></textarea>\r\n\r\n\t\t\t\t\t\t\t<div class=\"log-controls\">\r\n\t\t\t\t\t\t\t\t<button class=\"btn-secondary\" onclick=\"fetchLogs()\">\uD83D\uDD04 Refresh</button>\r\n\r\n\t\t\t\t\t\t\t\t<label>\r\n\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" class=\"pref-checkbox\" id=\"auto-refresh-toggle\" onchange=\"toggleAutoRefresh()\">\r\n\t\t\t\t\t\t\t\t\tAuto-Update\r\n\t\t\t\t\t\t\t\t</label>\r\n\r\n\t\t\t\t\t\t\t\t<label>\r\n\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" class=\"pref-checkbox\" id=\"verbose-debug-toggle\" onchange=\"toggleVerboseDebug()\">\r\n\t\t\t\t\t\t\t\t\tVerbose Debug\r\n\t\t\t\t\t\t\t\t</label>\r\n\r\n\t\t\t\t\t\t\t\t<button class=\"btn-primary\" style=\"--btn-bg-clr:#3498db;\" onclick=\"downloadLogs()\">\uD83D\uDCBE Download .txt</button>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t\t<section id=\"Wi-Fi-Setting\" class=\"tool-cards card\" data-accordion=\"Wi-Fi-Setting\" style=\"--card-border-accent-clr: #1abc9c;\">\r\n\t\t\t\t\t\t<div class=\"card-header toggable\"  onclick=\"toggleAccordion('Wi-Fi-Setting')\">\r\n\t\t\t\t\t\t\t<div class=\"card-heading-wrapper\">\r\n\t\t\t\t\t\t\t\t<h3 class=\"card-heading\">\uD83D\uDCF6 Wi-Fi Provisioning</h3>\r\n\t\t\t\t\t\t\t\t<span id=\"wifi-chevron\" class=\"chevron\">▼</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"card-sub-heading\">Push Wi-Fi credentials to a Wi-Fi connected speaker or via USB/Micro-USB setup cable.</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div id=\"wifi-container\" class=\"inner-collapse-container\">\r\n\t\t\t\t\t\t\t<div class=\"warning-box\">\r\n\t\t\t\t\t\t\t\t<strong>⚠\uFE0F IMPORTANT:</strong> The Network Name (SSID) and Password must be typed exactly and are <strong>case-sensitive</strong>. If entered incorrectly, the speaker will fail to connect and you will have to use either the USB cable approach or the native \"<span style=\"font-size: 0.85em;\">MANUAL WI-FI UPDATE</span>\" defined in the Setup Guide to fix it.\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"stream-grid\">\r\n\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t<label>NETWORK NAME (SSID)</label>\r\n\t\t\t\t\t\t\t\t\t<input type=\"text\" id=\"wifi-ssid\" placeholder=\"My Home Wi-Fi\">\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t<label>PASSWORD</label>\r\n\t\t\t\t\t\t\t\t\t<input type=\"text\" id=\"wifi-pass\" placeholder=\"My Wi-Fi Password\">\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"stream-controls\">\r\n\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t<label>Target:</label>\r\n\t\t\t\t\t\t\t\t\t<select id=\"wifi-target\"></select>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<button class=\"btn-primary\" onclick=\"pushWifi(this)\" style=\"--btn-bg-clr: var(--card-border-accent-clr)\">\uD83D\uDCE1 PUSH WI-FI</button>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</section>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t</main>\r\n\t</div>\r\n\r\n\r\n\t<div id=\"doc-modal\" class=\"modal\">\r\n\t\t<div class=\"modal-card\">\r\n\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t<h2>Reference Documents</h2>\r\n\t\t\t\t<button onclick=\"document.getElementById('doc-modal').style.display='none'\" class=\"modal-close-btn\">&times;</button>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"modal-content\">\r\n\t\t\t\t<div class=\"step-box\">\r\n\t\t\t\t\t<div class=\"step-text\">\r\n\t\t\t\t\t\t<a href=\"#\" onclick=\"openDoc('docs/SoundTouchHybridDocumentation.pdf'); return false;\" class=\"step-link\">\uD83D\uDCC4 Bose SoundTouch Hybrid Documentation</a>\r\n\t\t\t\t\t\t<a href=\"https://www.youtube.com/watch?v=R6mbTRBEBYA\" target=\"_blank\" class=\"step-link\">\uD83D\uDCFA Bose SoundTouch Hybrid 2026 Demo Video</a>\r\n\t\t\t\t\t\t<a href=\"https://www.youtube.com/watch?v=3BhAkpsZjBI\" target=\"_blank\" class=\"step-link\">\uD83D\uDCFA Bose SoundTouch Hybrid 2026 V2 Enhancements Demo Video</a>\r\n\t\t\t\t\t\t<a href=\"https://www.youtube.com/watch?v=ERsoMmyOpEU\" target=\"_blank\" class=\"step-link\">\uD83D\uDCFA Bose SoundTouch Hybrid 2026 V3 Enhancements Demo Video</a>\r\n\t\t\t\t\t\t<a href=\"https://github.com/TJGigs/Bose-SoundTouch-Hybrid-2026\" target=\"_blank\" class=\"step-link\">\uD83D\uDCBB Official GitHub Repository (Source Code)</a>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\t<div id=\"h-modal\" class=\"modal\">\r\n\t\t<div class=\"modal-card\">\r\n\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t<h2>Manual Setup Guide</h2>\r\n\t\t\t\t<button onclick=\"document.getElementById('h-modal').style.display='none'\" class=\"modal-close-btn\">&times;</button>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"modal-content\">\r\n\t\t\t\t<div class=\"step-box\">\r\n\t\t\t\t\t<span class=\"step-title\">\uD83D\uDCE1 MANUAL WI-FI SETUP</span>\r\n\t\t\t\t\t<div class=\"step-text\">\r\n\t\t\t\t\t\t1. Power on the speaker.<br>\r\n\t\t\t\t\t\t2. Press and hold <strong>2</strong> and <strong>- (Volume Down)</strong> for 5 seconds.<br>\r\n\t\t\t\t\t\t3. The Wi-Fi indicator will blink amber (Setup Mode).<br>\r\n\t\t\t\t\t\t4. Connect your device to Wi-Fi: <em>\"Bose SoundTouch X\"</em>.<br>\r\n\t\t\t\t\t\t5. Visit: <a href=\"http://192.168.1.1:8090\" target=\"_blank\">http://192.168.1.1:8090</a>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"step-box\">\r\n\t\t\t\t\t<span class=\"step-title\">\uD83D\uDD35 MANUAL BLUETOOTH PAIRING</span>\r\n\t\t\t\t\t<div class=\"step-text\">\r\n\t\t\t\t\t\t1. Select <strong>Bluetooth</strong> source.<br>\r\n\t\t\t\t\t\t2. Hold <strong>Bluetooth/AUX</strong> button until light blinks Blue.<br>\r\n\t\t\t\t\t\t3. Scan and pair on your phone.<br>\r\n\t\t\t\t\t\t<strong>Clear List:</strong> Hold <strong>Bluetooth/AUX</strong> for 10s (Double Tone).\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"step-box\">\r\n\t\t\t\t\t<span class=\"step-title\">\uD83D\uDD04 MANUAL FACTORY RESET</span>\r\n\t\t\t\t\t<div class=\"step-text\">\r\n\t\t\t\t\t\t<strong>SoundTouch 10, 20, 30:</strong><br>\r\n\t\t\t\t\t\tTurn the speaker on. Press and hold <strong>1</strong> and <strong>- (Volume Down)</strong> for 10 seconds until the indicators blink.<br>\r\n\t\t\t\t\t\t<strong>SoundTouch Wireless Link:</strong><br>\r\n\t\t\t\t\t\tPress and hold the <strong>Control</strong> button on the back for 10 seconds until the Wi-Fi indicator blinks white.\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"step-box\">\r\n\t\t\t\t<span class=\"step-title\">\uD83D\uDD0C MANUAL FIRMWARE UPDATE (USB)</span>\r\n\t\t\t\t\t<div class=\"step-text\">\r\n\t\t\t\t\t\t1. Connect the speaker to your computer via via USB/Micro-USB setup cable.<br>\r\n\t\t\t\t\t\t2. Open a web browser.<br>\r\n\t\t\t\t\t\t3. Visit the hidden update page: <a href=\"http://203.0.113.1/update.html\" target=\"_blank\">http://203.0.113.1/update.html</a><br>\r\n\t\t\t\t\t\t4. Select and upload your <em>Update.stu</em> firmware file.\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\t\r\n\t<div id=\"scriptModal\" class=\"modal\">\r\n\t\t<div class=\"modal-card\">\r\n\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t<h3>Download USB WiFI Setup Script</h3>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"modal-content\">\r\n\t\t\t\t<p class=\"warning-box\">\r\n\t\t\t\t\uD83C\uDF4E MAC USERS: This script is for Windows only. To setup speaker Wi-Fi via Mac, Use the native Bose method by connecting to the speaker's temporary initial setup amber-light Wi-Fi network and go to http://192.168.1.1 in your browser.\r\n\t\t\t\t</p>\r\n\t\t\t\t<pre id=\"scriptContent\"></pre>\r\n\t\t\t\t<div class=\"script-info\">\r\n\t\t\t\t\t<strong style=\"color: #66b3ff;\">\uD83D\uDEE1\uFE0F BROWSER DOWNLOAD WARNING:</strong><br>\r\n\t\t\t\t\tYour browser may warn you that this file is unrecognized or unsafe.<br>\r\n\t\t\t\t\tTo save it, select <strong>Keep</strong>, <strong>Save</strong>, or <strong>Accept</strong>.\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"scriptModal-btn-wrapper\">\r\n\t\t\t\t\t<button id=\"cancelScriptBtn\" style=\"--btn-bg-clr: #555; color: white;\" class=\"btn-primary\">Cancel</button>\r\n\t\t\t\t\t<button id=\"downloadScriptBtn\" style=\"--btn-bg-clr: #007bff; color: white;\" class=\"btn-primary\">Download Script</button>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\t<div id=\"pdf-modal\" class=\"modal\">\r\n\t\t<div class=\"modal-card pdf-mode\">\r\n\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t<h2>Document Viewer</h2>\r\n\t\t\t\t<div class=\"pdf-modal-btn-wrapper\">\r\n\t\t\t\t\t<button class=\"btn-sm\" onclick=\"openExternalDoc()\">Open in Browser ↗</button>\r\n\t\t\t\t\t<button onclick=\"closeDoc()\" class=\"modal-close-btn\">&times;</button>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<object id=\"pdf-frame\" class=\"pdf-frame\" data=\"\" type=\"application/pdf\">\r\n\t\t\t\t<div>\r\n\t\t\t\t\tPreview not available on this device.<br>\r\n\t\t\t\t\t<button class=\"btn-secondary\" onclick=\"openExternalDoc()\">Open PDF</button>\r\n\t\t\t\t</div>\r\n\t\t\t</object>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\r\n\r\n\t<script>\r\n\t\tconst SERVER_URL = window.location.protocol + \"//\" + window.location.host;\r\n\r\n\t\tfunction switchToolsTab(tabName) {\r\n\t\t    document.querySelectorAll('[data-tab-name]').forEach(panel => {\r\n\t\t        panel.style.display = panel.getAttribute(\"data-tab-name\") === `${tabName}` ? 'block' : 'none';\r\n\t\t    });\r\n\t\t    document.querySelectorAll('[data-tab-btn]').forEach(btn => {\r\n\t\t        btn.classList.toggle('active', btn.getAttribute('data-tab-btn') === tabName);\r\n\t\t    });\r\n\t\t}\r\n\r\n\t\tfunction hourOptions(selectedHour) {\r\n\t\t    return Array.from({ length: 24 }, (_, h) => {\r\n\t\t        const label = h.toString().padStart(2, '0') + ':00';\r\n\t\t        return `<option value=\"${h}\"${h === selectedHour ? ' selected' : ''}>${label}</option>`;\r\n\t\t    }).join('');\r\n\t\t}\r\n\r\n\t\tfunction populatePlayTimeSelect() {\r\n\t\t    const hourSel = document.getElementById('newPlayHour');\r\n\t\t    const minSel  = document.getElementById('newPlayMinute');\r\n\t\t    if (!hourSel || !minSel) return;\r\n\t\t    const hourOpts = ['<option value=\"\" disabled selected>HH</option>'];\r\n\t\t    for (let h = 0; h < 24; h++) {\r\n\t\t        hourOpts.push(`<option value=\"${h}\">${h.toString().padStart(2, '0')}</option>`);\r\n\t\t    }\r\n\t\t    hourSel.innerHTML = hourOpts.join('');\r\n\t\t    const minOpts = ['<option value=\"\" disabled selected>MM</option>'];\r\n\t\t    for (let m = 0; m < 60; m += 5) {\r\n\t\t        minOpts.push(`<option value=\"${m}\">${m.toString().padStart(2, '0')}</option>`);\r\n\t\t    }\r\n\t\t    minSel.innerHTML = minOpts.join('');\r\n\t\t}\r\n\r\n\t\tfunction populateHourSelects() {\r\n\t\t    const auditSel   = document.getElementById('pref_scheduledAuditHour');\r\n\t\t    const restartSel = document.getElementById('pref_scheduledRestartHour');\r\n\t\t    const ah = fullSettingsPayload.scheduledAuditHour   ?? 2;\r\n\t\t    const rh = fullSettingsPayload.scheduledRestartHour ?? 3;\r\n\t\t    if (auditSel)   auditSel.innerHTML   = hourOptions(ah);\r\n\t\t    if (restartSel) restartSel.innerHTML = hourOptions(rh);\r\n\t\t}\r\n\r\n\t\t// Handles programmatic unchecking and UI state rendering safely\r\n\t\tfunction handleAuditToggle() {\r\n\t\t    const check = document.getElementById('pref_scheduledSpeakerAudit');\r\n\t\t    const sel   = document.getElementById('pref_scheduledAuditHour');\r\n\t\t    if (check && sel) sel.disabled = !check.checked;\r\n\t\t}\r\n\r\n\t\tfunction handleScheduledRestartToggle() {\r\n\t\t    const parentCheck = document.getElementById('pref_scheduledRestart');\r\n\t\t    const childCheck  = document.getElementById('pref_includeReboot');\r\n\t\t    const restartSel  = document.getElementById('pref_scheduledRestartHour');\r\n\r\n\t\t    if (parentCheck && childCheck) {\r\n\t\t        childCheck.disabled = !parentCheck.checked;\r\n\t\t        if (!parentCheck.checked) childCheck.checked = false;\r\n\t\t    }\r\n\t\t    if (parentCheck && restartSel) restartSel.disabled = !parentCheck.checked;\r\n\t\t}\r\n\r\n\t\t// --- GLOBAL SETTINGS LOGIC ---\r\n\t\tlet currentSearchOrder = [];\r\n\t\tlet fullSettingsPayload = {};\r\n\r\n\t\t// Known local icons — these always win over MASS-provided icons\r\n\t\tconst KNOWN_LOCAL_ICONS = {\r\n\t\t    'global':           null,\r\n\t\t    'spotify':          '/images/spotify_icon.png',\r\n\t\t    'tunein':           '/images/TuneIn_icon.png',\r\n\t\t    'filesystem_local': '/images/nas_icon.png',\r\n\t\t    'file':             '/images/nas_icon.png'\r\n\t\t};\r\n\r\n\t\t// Radio providers whose domain name doesn't contain the word \"radio\"\r\n\t\t// Update this list as new radio-only providers are discovered in MASS\r\n\t\tconst RADIO_PROVIDER_DOMAINS = new Set(['tunein', 'siriusxm', 'somafm']);\r\n\r\n\t\tfunction getSourceType(domain) {\r\n\t\t    if (domain === 'global') return 'global';\r\n\t\t    return (RADIO_PROVIDER_DOMAINS.has(domain) || domain.includes('radio')) ? 'radio' : 'music';\r\n\t\t}\r\n\r\n\t\t// Legacy key remapping (old synthetic keys → real MASS domain keys)\r\n\t\tconst LEGACY_KEY_MAP = {\r\n\t\t    'radio': 'tunein',\r\n\t\t    'nas':   'filesystem_local'\r\n\t\t};\r\n\r\n\t\t// 1. Fetch from Server\r\n\t\tasync function loadConfig() {\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/api/admin/settings');\r\n\t\t\t\tif (res.ok) {\r\n\t\t\t\t\tfullSettingsPayload = await res.json();\r\n\r\n\t\t            // Load Menu Order — migrate legacy string array if server hasn't done it yet\r\n\t\t            let raw = fullSettingsPayload.searchMenuOrder || [];\r\n\t\t            if (raw.length > 0 && typeof raw[0] === 'string') {\r\n\t\t                raw = raw.map(legacyKey => ({\r\n\t\t                    key:        LEGACY_KEY_MAP[legacyKey] || legacyKey,\r\n\t\t                    name:       { global: 'Global', radio: 'TuneIn Radio', nas: 'Local NAS', spotify: 'Spotify' }[legacyKey] || legacyKey,\r\n\t\t                    icon:       KNOWN_LOCAL_ICONS[LEGACY_KEY_MAP[legacyKey] || legacyKey] || null,\r\n\t\t                    enabled:    true,\r\n\t\t                    sourceType: legacyKey === 'radio' ? 'radio' : legacyKey === 'global' ? 'global' : 'music'\r\n\t\t                }));\r\n\t\t            }\r\n\t\t            currentSearchOrder = raw;\r\n\t\t            renderSortableList();\r\n\r\n\t\t\t\t\t// Load Checkboxes\r\n\t\t\t\t\tdocument.getElementById('pref_autoResume').checked = fullSettingsPayload.autoResumePreset === true;\r\n\t\t\t\t\tdocument.getElementById('pref_autoRestart').checked = fullSettingsPayload.autoRestartMass === true;\r\n\t\t\t\t\tdocument.getElementById('pref_autoSync').checked = fullSettingsPayload.autoSyncVolume === true;\r\n\t\t\t\t\tdocument.getElementById('pref_mobileAutoSortSpeakers').checked = fullSettingsPayload.mobileAutoSortSpeakers === true;\r\n\t\t\t\t\tdocument.getElementById('pref_scheduledSpeakerAudit').checked = fullSettingsPayload.scheduledSpeakerAudit === true;\r\n\t\t\t\t\tdocument.getElementById('pref_scheduledRestart').checked = fullSettingsPayload.scheduledRestart === true;\r\n\t\t\t\t\tconst subReboot = document.getElementById('pref_includeReboot');\r\n\t\t\t\t\tsubReboot.checked = fullSettingsPayload.includeReboot === true;\r\n\t\t\t\t\tsubReboot.disabled = !fullSettingsPayload.scheduledRestart;\r\n\t\t\t\t\tdocument.getElementById('pref_bypassCloudEmulation').checked = fullSettingsPayload.bypassCloudEmulation === true;\r\n\r\n\t\t            // Hour selects — populate after fullSettingsPayload is set\r\n\t\t            populateHourSelects();\r\n\t\t            const auditSel   = document.getElementById('pref_scheduledAuditHour');\r\n\t\t            const restartSel = document.getElementById('pref_scheduledRestartHour');\r\n\t\t            if (auditSel)   auditSel.disabled   = !fullSettingsPayload.scheduledSpeakerAudit;\r\n\t\t            if (restartSel) restartSel.disabled = !fullSettingsPayload.scheduledRestart;\r\n\r\n\t\t            // Re-render scheduled plays now that settings are loaded\r\n\t\t            renderScheduledPlays();\r\n\t\t        }\r\n\t\t\t} catch (e) {\r\n\t\t\t\tconsole.error(\"Failed to load settings from server\", e);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// Draw the drag-and-drop list\r\n\t\tfunction renderSortableList() {\r\n\t\t\tconst container = document.getElementById('sortable-list');\r\n\r\n\t\t    container.innerHTML = currentSearchOrder.map((entry, index) => {\r\n\t\t        const isGlobal = entry.key === 'global';\r\n\t\t        const isHidden = !entry.enabled;\r\n\t\t        const iconHtml = entry.key === 'global'\r\n\t\t            ? `<span>\uD83C\uDF0D</span>`\r\n\t\t            : `<img src=\"${entry.icon || '/images/ma_icon.png'}\" onerror=\"this.src='/images/ma_icon.png'\">`;\r\n\r\n\t\t        return `\r\n\t\t\t<div class=\"sortable-list-item ${isHidden ? 'hidden' : ''}\">\r\n\t\t\t    ${!isGlobal ? `<button class=\"hide-icon\" onclick=\"toggleHideEntry(${index})\" title=\"${isHidden ? 'Show on library page' : 'Hide from library page'}\">${isHidden ? '\uD83D\uDC41' : '✕'}</button>` : ''}\r\n\t\t\t\t<div class=\"source-icon\">${iconHtml}</div>\r\n\t\t\t\t<span class=\"sortable-list-title\" title=\"${entry.name}\">${entry.name}</span>\r\n\t\t\t\t<div class=\"sortable-list-btn-wrapper\">\r\n\t\t\t\t\t<button class=\"btn-sm ${index === 0 ? 'hidden\" disabled' : '\"'} onclick=\"moveItem(${index}, -1)\" >◀</button>\r\n\t\t\t\t\t<button class=\"btn-sm ${index === currentSearchOrder.length - 1 ? 'hidden\" disabled' : '\"'} onclick=\"moveItem(${index}, 1)\" >▶</button>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t`}).join('');\r\n\t\t}\r\n\r\n\t\tfunction moveItem(index, direction) {\r\n\t\t\tconst newIndex = index + direction;\r\n\t\t    if (newIndex < 0 || newIndex >= currentSearchOrder.length) return;\r\n\t\t\tconst temp = currentSearchOrder[index];\r\n\t\t\tcurrentSearchOrder[index] = currentSearchOrder[newIndex];\r\n\t\t\tcurrentSearchOrder[newIndex] = temp;\r\n\t\t\trenderSortableList(); \r\n\t\t}\r\n\r\n\t\tfunction toggleHideEntry(index) {\r\n\t\t    currentSearchOrder[index].enabled = !currentSearchOrder[index].enabled;\r\n\t\t    renderSortableList();\r\n\t\t}\r\n\r\n\t\t// 2. Save Menu Order\r\n\t\tasync function saveSearchOrder() {\r\n\t\t\tfullSettingsPayload.searchMenuOrder = currentSearchOrder;\r\n\t\t\tawait pushSettingsToServer(\"✅ Menu order synchronized across all devices!\");\r\n\t\t}\r\n\r\n\t\t// 3. Refresh provider tabs from Music Assistant\r\n\t\tasync function refreshProvidersFromMass() {\r\n\t\t    const btn = event.currentTarget;\r\n\t\t    const orig = btn.innerHTML;\r\n\t\t    btn.innerHTML = '⏳ Fetching...';\r\n\t\t    btn.disabled = true;\r\n\r\n\t\t    try {\r\n\t\t        const res = await fetch('/api/manager/providers');\r\n\t\t        if (!res.ok) throw new Error('Server error');\r\n\t\t        const massProviders = await res.json();\r\n\r\n\t\t        const added = [];\r\n\t\t        const updated = [];\r\n\t\t        const removed = [];\r\n\r\n\t\t        // Find entries in current list that are no longer in MASS (excluding global)\r\n\t\t        currentSearchOrder.forEach(entry => {\r\n\t\t            if (entry.key === 'global') return;\r\n\t\t            const stillExists = massProviders.some(p => p.domain === entry.key);\r\n\t\t            if (!stillExists) removed.push(entry.name);\r\n\t\t        });\r\n\r\n\t\t        // Remove deleted providers\r\n\t\t        currentSearchOrder = currentSearchOrder.filter(entry => {\r\n\t\t            if (entry.key === 'global') return true;\r\n\t\t            return massProviders.some(p => p.domain === entry.key);\r\n\t\t        });\r\n\r\n\t\t        // Add new or update existing\r\n\t\t        massProviders.forEach(p => {\r\n\t\t            const existingIndex = currentSearchOrder.findIndex(e => e.key === p.domain);\r\n\t\t            const localIcon = KNOWN_LOCAL_ICONS[p.domain] || null;\r\n\t\t            const resolvedIcon = localIcon || p.icon || null;\r\n\r\n\t\t            if (existingIndex >= 0) {\r\n\t\t                // Update name and icon only — preserve enabled state and position\r\n\t\t                const prev = currentSearchOrder[existingIndex];\r\n\t\t                if (prev.name !== p.name || prev.icon !== resolvedIcon) {\r\n\t\t                    currentSearchOrder[existingIndex].name = p.name;\r\n\t\t                    currentSearchOrder[existingIndex].icon = resolvedIcon;\r\n\t\t                    updated.push(p.name);\r\n\t\t                }\r\n\t\t            } else {\r\n\t\t                // New provider — append to far right\r\n\t\t                currentSearchOrder.push({\r\n\t\t                    key:        p.domain,\r\n\t\t                    name:       p.name,\r\n\t\t                    icon:       resolvedIcon,\r\n\t\t                    enabled:    true,\r\n\t\t                    sourceType: getSourceType(p.domain)\r\n\t\t                });\r\n\t\t                added.push(p.name);\r\n\t\t            }\r\n\t\t        });\r\n\r\n\t\t        renderSortableList();\r\n\r\n\t\t        // Build summary\r\n\t\t        const parts = [];\r\n\t\t        if (added.length)   parts.push(`✅ Added: ${added.join(', ')}`);\r\n\t\t        if (updated.length) parts.push(`\uD83D\uDD04 Updated: ${updated.join(', ')}`);\r\n\t\t        if (removed.length) parts.push(`\uD83D\uDDD1\uFE0F Removed: ${removed.join(', ')}`);\r\n\t\t        const summary = parts.length ? parts.join('\\n') : 'No changes — your tab list is already up to date.';\r\n\r\n\t\t        alert(`MASS Provider Sync Complete\\n\\n${summary}\\n\\nClick \"\uD83D\uDCBE Save Layout\" to apply these changes.`);\r\n\r\n\t\t    } catch (e) {\r\n\t\t        alert('❌ Could not reach Music Assistant. Check that MASS is running and try again.');\r\n\t\t    }\r\n\r\n\t\t    btn.innerHTML = orig;\r\n\t\t    btn.disabled = false;\r\n\t\t}\r\n\r\n\t\t// 3. Save Checkboxes\r\n\t\tasync function savePreferences() {\r\n\t\t    fullSettingsPayload.autoResumePreset = document.getElementById('pref_autoResume').checked;\r\n\t\t    fullSettingsPayload.autoRestartMass = document.getElementById('pref_autoRestart').checked;\r\n\t\t    fullSettingsPayload.autoSyncVolume = document.getElementById('pref_autoSync').checked;\r\n\t\t    fullSettingsPayload.mobileAutoSortSpeakers = document.getElementById('pref_mobileAutoSortSpeakers').checked;\r\n\t\t    fullSettingsPayload.scheduledSpeakerAudit  = document.getElementById('pref_scheduledSpeakerAudit').checked;\r\n\t\t    fullSettingsPayload.scheduledAuditHour    = parseInt(document.getElementById('pref_scheduledAuditHour').value, 10);\r\n\t\t    fullSettingsPayload.scheduledRestart      = document.getElementById('pref_scheduledRestart').checked;\r\n\t\t    fullSettingsPayload.scheduledRestartHour  = parseInt(document.getElementById('pref_scheduledRestartHour').value, 10);\r\n\t\t    fullSettingsPayload.includeReboot         = document.getElementById('pref_includeReboot').checked;\r\n\t\t    fullSettingsPayload.bypassCloudEmulation  = document.getElementById('pref_bypassCloudEmulation').checked;\r\n\t\t\tawait pushSettingsToServer(\"✅ Preferences saved successfully!\");\r\n\t\t}\r\n\r\n\t\t// 4. The Master Save Function\r\n\t\tasync function pushSettingsToServer(successMessage) {\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/api/admin/settings', {\r\n\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\theaders: {\r\n\t\t\t\t\t\t'Content-Type': 'application/json'\r\n\t\t\t\t\t},\r\n\t\t\t\t\tbody: JSON.stringify(fullSettingsPayload)\r\n\t\t\t\t});\r\n\r\n\t\t\t\tif (res.ok)\r\n\t\t\t\t\talert(successMessage);\r\n\t\t\t\telse\r\n\t\t\t\t\talert(\"❌ Failed to save to server.\");\r\n\t\t\t} catch (e) {\r\n\t\t\t\talert(\"❌ Network Error: \" + e.message);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// Fetch the actual backend state on page load\r\n\t\tasync function syncDebugToggle() {\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/api/admin/debug_state');\r\n\t\t\t\tconst data = await res.json();\r\n\t\t\t\tconst toggle = document.getElementById('verbose-debug-toggle');\r\n\t\t\t\tif (toggle) {\r\n\t\t\t\t\ttoggle.checked = data.debug;\r\n\t\t\t\t}\r\n\t\t\t} catch (e) {\r\n\t\t\t\tconsole.error(\"Could not sync debug state\", e);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// Load config and sync backend states when tools page opens\r\n\t\twindow.addEventListener('DOMContentLoaded', () => {\r\n\t\t    loadConfig();\r\n\t\t    syncDebugToggle();\r\n\t\t    populatePlayTimeSelect();\r\n\t\t    // Init Dark Mode checkbox from localStorage\r\n\t\t    const darkCheck = document.getElementById('pref_darkMode');\r\n\t\t    if (darkCheck) darkCheck.checked = (localStorage.getItem('theme') !== 'light');\r\n\t\t    //fetchLogs(); only needed if log view defaults to open\r\n\t\t});\r\n\r\n\t\tfunction toggleThemeFromPref(checkbox) {\r\n\t\t    const isDark = checkbox.checked;\r\n\t\t    document.body.classList.toggle('light-mode', !isDark);\r\n\t\t    localStorage.setItem('theme', isDark ? 'dark' : 'light');\r\n\t\t}\r\n\r\n\t\tlet currentDocUrl = \"\";\r\n\t\tfunction openDoc(url) {\r\n\t\t\tcurrentDocUrl = url;\r\n\t\t\tdocument.getElementById('doc-modal').style.display = 'none';\r\n\t\t\tif (window.innerWidth <= 768) {\r\n\t\t\t\tconst pdfModal = document.getElementById('pdf-modal');\r\n\t\t\t\tconst pdfFrame = document.getElementById('pdf-frame');\r\n\t\t\t\tpdfFrame.setAttribute('data', url);\r\n\t\t\t\tpdfModal.style.display = 'flex';\r\n\t\t\t} else\r\n\t\t\t\twindow.open(url, '_blank');\r\n\t\t}\r\n\t\tfunction closeDoc() {\r\n\t\t\tdocument.getElementById('pdf-modal').style.display = 'none';\r\n\t\t\tdocument.getElementById('pdf-frame').setAttribute('data', '');\r\n\t\t}\r\n\t\tfunction openExternalDoc() {\r\n\t\t\tif (currentDocUrl)\r\n\t\t\t\twindow.open(currentDocUrl, '_blank');\r\n\t\t}\r\n\r\n\t\tasync function fetchLogs() {\r\n\t\t\tconst viewer = document.getElementById('live-log-viewer');\r\n\t\t\tif (!viewer)\r\n\t\t\t\treturn;\r\n\t\t\tviewer.value = \"Fetching logs...\";\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/api/logs');\r\n\t\t\t\tconst text = await res.text();\r\n\t\t\t\tviewer.value = text || \"No logs available yet.\";\r\n\t\t\t\t// Auto-scroll to the bottom (newest logs)\r\n\t\t\t\tviewer.scrollTop = viewer.scrollHeight;\r\n\t\t\t} catch (e) {\r\n\t\t\t\tviewer.value = \"Failed to load logs. Is the server running?\";\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfunction downloadLogs() {\r\n\t\t\tconst text = document.getElementById('live-log-viewer').value;\r\n\t\t\tif (!text || text.includes(\"Fetching logs...\"))\r\n\t\t\t\treturn alert(\"No logs to download yet.\");\r\n\r\n\t\t\tconst blob = new Blob([text], {\r\n\t\t\t\ttype: 'text/plain'\r\n\t\t\t});\r\n\t\t\tconst a = document.createElement('a');\r\n\t\t\ta.href = URL.createObjectURL(blob);\r\n\t\t\ta.download = `hybrid-server-logs-${new Date().toISOString().slice(0, 10)}.txt`;\r\n\t\t\tdocument.body.appendChild(a);\r\n\t\t\ta.click();\r\n\t\t\tdocument.body.removeChild(a);\r\n\t\t}\r\n\t\tlet liveLogTimer = null;\r\n\r\n\r\n\t\tfunction toggleAutoRefresh() {\r\n\t\t\tconst isChecked = document.getElementById('auto-refresh-toggle').checked;\r\n\t\t\tif (isChecked) {\r\n\t\t\t\tfetchLogs(); // Update immediately\r\n\t\t\t\tliveLogTimer = setInterval(fetchLogs, 2000);\r\n\t\t\t} else {\r\n\t\t\t\tclearInterval(liveLogTimer); // Stop updating\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tasync function toggleVerboseDebug() {\r\n\t\t\tconst isChecked = document.getElementById('verbose-debug-toggle').checked;\r\n\t\t\ttry {\r\n\t\t\t\tawait fetch('/api/admin/toggle_debug', {\r\n\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\theaders: {\r\n\t\t\t\t\t\t'Content-Type': 'application/json'\r\n\t\t\t\t\t},\r\n\t\t\t\t\tbody: JSON.stringify({\r\n\t\t\t\t\t\tdebug: isChecked\r\n\t\t\t\t\t})\r\n\t\t\t\t});\r\n\t\t\t} catch (e) {\r\n\t\t\t\tconsole.error(\"Failed to toggle debug\", e);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\t\tfunction toggleAccordion(triggerTarget) {\r\n\t\t\tconst accordion = document.querySelector(`[data-accordion=\"${triggerTarget}\"]`);\t\r\n\r\n\r\n\t\t\tif (accordion.classList.contains('open')) {\r\n\t\t\t\taccordion.classList.remove('open');\r\n\r\n\t\t\t\tif (accordion.id === \"server-log\") {\r\n\t\t\t\t\tclearInterval(liveLogTimer);\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\taccordion.classList.add('open');\r\n\t\t\t\tif (accordion.id === \"server-log\") {\r\n\t\t\t\t\tfetchLogs(); // Fetch immediately on open\r\n\r\n\t\t\t\t\t// Start interval if checkbox is checked\r\n\t\t\t\t\tif (document.getElementById('auto-refresh-toggle').checked) {\r\n\t\t\t\t\t\tliveLogTimer = setInterval(fetchLogs, 2000);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\t\t// =====================================================================\r\n\t\t// SCHEDULED PLAY — CRUD\r\n\t\t// =====================================================================\r\n\t\tlet scheduledPlaysDevices = [];\r\n\r\n\t\tfunction initScheduledPlays(devices) {\r\n\t\t    scheduledPlaysDevices = Array.isArray(devices) ? devices.filter(d => d.online) : [];\r\n\t\t    renderScheduledPlays();\r\n\t\t    updateNewPlaySpeakerOptions();\r\n\t\t}\r\n\r\n\t\tfunction renderScheduledPlays() {\r\n\t\t    const list   = document.getElementById('scheduledPlaysList');\r\n\t\t    const empty  = document.getElementById('scheduledPlaysEmpty');\r\n\t\t    const badge  = document.getElementById('scheduledPlayCount');\r\n\t\t    const plays  = Array.isArray(fullSettingsPayload.scheduledPlays) ? fullSettingsPayload.scheduledPlays : [];\r\n\t\t    const usedIps = new Set(plays.map(p => p.speakerIp));\r\n\r\n\t\t    if (badge) badge.textContent = `${plays.length} Schedule${plays.length !== 1 ? 's' : ''}`;\r\n\t\t    if (!list) return;\r\n\r\n\t\t    // Clear existing rows (keep the empty placeholder node)\r\n\t\t    [...list.querySelectorAll('li.sp-row')].forEach(el => el.remove());\r\n\r\n\t\t    if (plays.length === 0) {\r\n\t\t        if (empty) empty.style.display = '';\r\n\t\t        return;\r\n\t\t    }\r\n\t\t    if (empty) empty.style.display = 'none';\r\n\r\n\t\t    plays.forEach((play, idx) => {\r\n\t\t        const li = document.createElement('li');\r\n\t\t        li.className = 'sp-row';\r\n\t\t        li.style.cssText = 'display:flex; align-items:center; gap:10px; padding:10px; background:var(--input-bg); border-bottom:1px solid var(--border); flex-wrap:wrap;';\r\n\r\n\t\t        // Speaker label\r\n\t\t        const dev = scheduledPlaysDevices.find(d => d.ip === play.speakerIp);\r\n\t\t        const spLabel = dev ? `${dev.name} (${play.speakerIp})` : play.speakerIp;\r\n\r\n\t\t        const h = play.hour ?? 0;\r\n\t\t        const m = play.minute ?? 0;\r\n\t\t        const ampm = h < 12 ? 'AM' : 'PM';\r\n\t\t        const h12  = h % 12 || 12;\r\n\t\t        const timeLabel = `${h12}:${String(m).padStart(2,'0')} ${ampm}`;\r\n\r\n\t\t        li.innerHTML = `\r\n\t\t            <span style=\"color:var(--text); font-weight:bold; white-space:nowrap;\">${timeLabel} — Preset ${play.preset} — ${spLabel}</span>\r\n\t\t            <span style=\"flex-grow:1;\"></span>\r\n\t\t            <button onclick=\"removeScheduledPlay(${idx})\" style=\"background:var(--danger); color:#fff; border:none; padding:5px 10px; border-radius:4px; cursor:pointer;\">✕</button>\r\n\t\t        `;\r\n\t\t        list.appendChild(li);\r\n\t\t    });\r\n\r\n\t\t    updateNewPlaySpeakerOptions();\r\n\t\t}\r\n\r\n\t\tfunction updateNewPlaySpeakerOptions() {\r\n\t\t    const sel    = document.getElementById('newPlaySpeaker');\r\n\t\t    const addBtn = document.getElementById('addScheduledPlayBtn');\r\n\t\t    if (!sel) return;\r\n\r\n\t\t    const plays   = Array.isArray(fullSettingsPayload.scheduledPlays) ? fullSettingsPayload.scheduledPlays : [];\r\n\t\t    const usedIps = new Set(plays.map(p => p.speakerIp));\r\n\r\n\t\t    const available = scheduledPlaysDevices.filter(d => !usedIps.has(d.ip));\r\n\t\t    sel.innerHTML = '<option value=\"\" disabled selected>Select speaker...</option>' +\r\n\t\t        scheduledPlaysDevices.map(d => {\r\n\t\t            const used = usedIps.has(d.ip);\r\n\t\t            return `<option value=\"${d.ip}\" ${used ? 'disabled style=\"color:var(--text-secondary);\"' : ''}>${d.name} (${d.ip})${used ? ' — Scheduled' : ''}</option>`;\r\n\t\t        }).join('');\r\n\r\n\t\t    if (addBtn) addBtn.disabled = available.length === 0;\r\n\t\t}\r\n\r\n\t\tasync function addScheduledPlay() {\r\n\t\t    const hourSel    = document.getElementById('newPlayHour');\r\n\t\t    const minSel     = document.getElementById('newPlayMinute');\r\n\t\t    const speakerSel = document.getElementById('newPlaySpeaker');\r\n\t\t    const presetSel  = document.getElementById('newPlayPreset');\r\n\r\n\t\t    const hVal   = hourSel?.value;\r\n\t\t    const mVal   = minSel?.value;\r\n\t\t    const ip     = speakerSel?.value;\r\n\t\t    const preset = parseInt(presetSel?.value || '1', 10);\r\n\r\n\t\t    if (hVal === '' || hVal == null || mVal === '' || mVal == null || !ip) return alert('Please select a time and a speaker.');\r\n\r\n\t\t    const h = parseInt(hVal, 10);\r\n\t\t    const m = parseInt(mVal, 10);\r\n\r\n\t\t    if (!fullSettingsPayload.scheduledPlays) fullSettingsPayload.scheduledPlays = [];\r\n\t\t    fullSettingsPayload.scheduledPlays.push({ speakerIp: ip, preset, hour: h, minute: m });\r\n\r\n\t\t    // Reset add-row\r\n\t\t    hourSel.selectedIndex = 0;\r\n\t\t    minSel.selectedIndex  = 0;\r\n\t\t    speakerSel.value = '';\r\n\r\n\t\t    renderScheduledPlays();\r\n\t\t    await saveScheduledPlays();\r\n\t\t}\r\n\r\n\t\tasync function removeScheduledPlay(index) {\r\n\t\t    if (!Array.isArray(fullSettingsPayload.scheduledPlays)) return;\r\n\t\t    fullSettingsPayload.scheduledPlays.splice(index, 1);\r\n\t\t    renderScheduledPlays();\r\n\t\t    await saveScheduledPlays();\r\n\t\t}\r\n\r\nasync function saveScheduledPlays(silent = false) {\r\n\t\t    if (silent) {\r\n\t\t        // Fire-and-forget without alert\r\n\t\t        fetch('/api/admin/settings', {\r\n\t\t            method: 'POST',\r\n\t\t            headers: { 'Content-Type': 'application/json' },\r\n\t\t            body: JSON.stringify(fullSettingsPayload)\r\n\t\t        }).catch(e => console.error('[ScheduledPlay] Save failed:', e.message));\r\n\t\t    } else {\r\n\t\t        await pushSettingsToServer('✅ Scheduled plays saved.');\r\n\t\t    }\r\n\t\t}\r\n\t\t// =====================================================================\r\n\r\n\t\tasync function loadTools() {\r\n\t\t\ttry {\r\n\t\t\t\tconst statusRes = await fetch('/api/status');\r\n\t\t\t\tconst devices = await statusRes.json();\r\n\r\n\t\t\t\tconst allOptions = devices.filter(d => d.online).map(d => `<option value=\"${d.ip}\">${d.name} (${d.ip})</option>`).join('');\r\n\t\t\t\tconst usbOption = `<option value=\"203.0.113.1\">\uD83D\uDD0C USB Cable / Initial Wi-Fi Setup (203.0.113.1)</option>`;\r\n\r\n\t\t\t\t// Populate Wi-Fi dropdown\r\n\t\t\t\tconst wifiTarget = document.getElementById('wifi-target');\r\n\t\t\t\tif (wifiTarget)\r\n\t\t\t\t\twifiTarget.innerHTML = usbOption + allOptions;\r\n\r\n\t\t\t\t// Populate Force Injection dropdown\r\n\t\t\t\tconst forceTarget = document.getElementById('forceSpeakerSelect');\r\n\t\t\t\tif (forceTarget)\r\n\t\t\t\t\tforceTarget.innerHTML = '<option value=\"all\">All Speakers</option>' + allOptions;\r\n\r\n\t\t\t\t// Populate Force Reboot dropdown\r\n\t\t\t\tconst rebootTarget = document.getElementById('forceRebootSelect');\r\n\t\t\t\tif (rebootTarget)\r\n\t\t\t\t\trebootTarget.innerHTML = '<option value=\"all\">All Speakers</option>' + allOptions;\r\n\r\n\t\t\t\t// ---> BOOT STEREO UI WITH SHARED DATA\r\n\t\t\t\tinitStereoUI(devices);\r\n\r\n\t\t\t} catch (e) {\r\n\t\t\t\tconsole.error(\"Failed to load tools / status\", e);\r\n\t\t\t\t// Still boot the stereo UI with an empty array so dummies inject\r\n\t\t\t\tinitStereoUI([]);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// --- EXISTING FUNCTIONS ---\r\n\r\n\t\t// LEVEL 1: Soft Rescan (The Ping)\r\n\t\tasync function rescanMass(btn) {\r\n\t\t\tconst orig = btn.innerText;\r\n\t\t\tbtn.innerText = \"Pinging...\";\r\n\t\t\tbtn.disabled = true;\r\n\r\n\t\t\ttry {\r\n\t\t\t\t// A single Soft Ping (players/all) globally refreshes ALL idle sockets\r\n\t\t\t\tawait fetch('/api/admin/rescan_ma', {\r\n\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\theaders: {\r\n\t\t\t\t\t\t'Content-Type': 'application/json'\r\n\t\t\t\t\t},\r\n\t\t\t\t\t// Sending a fixed string so the backend logs properly identify both protocols\r\n\t\t\t\t\tbody: JSON.stringify({\r\n\t\t\t\t\t\taggressive: false,\r\n\t\t\t\t\t\tprovider: 'dlna & airplay'\r\n\t\t\t\t\t})\r\n\t\t\t\t});\r\n\r\n\t\t\t\tbtn.innerText = \"✅ Network Pinged\";\r\n\t\t\t} catch (e) {\r\n\t\t\t\tbtn.innerText = \"❌ Error\";\r\n\t\t\t}\r\n\r\n\t\t\tsetTimeout(() => {\r\n\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\tbtn.disabled = false;\r\n\t\t\t}, 3000);\r\n\t\t}\r\n\r\n\t\t// LEVEL 2: Aggressive Provider Reload (DLNA + AirPlay)\r\n\t\tasync function aggressiveReloadMass(btn) {\r\n\t\t\tif (!confirm(\"Forcefully restart the DLNA and AirPlay providers?\\n⚠\uFE0F Warning: Active audio streams may momentarily stop.\"))\r\n\t\t\t\treturn;\r\n\t\t\tconst orig = btn.innerText;\r\n\t\t\tbtn.innerText = \"Reloading DLNA...\";\r\n\t\t\tbtn.disabled = true;\r\n\r\n\t\t\ttry {\r\n\t\t\t\t// 1. Reload DLNA\r\n\t\t\t\tawait fetch('/api/admin/rescan_ma', {\r\n\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\theaders: {\r\n\t\t\t\t\t\t'Content-Type': 'application/json'\r\n\t\t\t\t\t},\r\n\t\t\t\t\tbody: JSON.stringify({\r\n\t\t\t\t\t\taggressive: true,\r\n\t\t\t\t\t\tprovider: 'dlna'\r\n\t\t\t\t\t})\r\n\t\t\t\t});\r\n\r\n\t\t\t\tbtn.innerText = \"Reloading AirPlay...\";\r\n\r\n\t\t\t\t// 2. Reload AirPlay\r\n\t\t\t\tawait fetch('/api/admin/rescan_ma', {\r\n\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\theaders: {\r\n\t\t\t\t\t\t'Content-Type': 'application/json'\r\n\t\t\t\t\t},\r\n\t\t\t\t\tbody: JSON.stringify({\r\n\t\t\t\t\t\taggressive: true,\r\n\t\t\t\t\t\tprovider: 'airplay'\r\n\t\t\t\t\t})\r\n\t\t\t\t});\r\n\r\n\t\t\t\tbtn.innerText = \"✅ Providers Reloaded\";\r\n\t\t\t} catch (e) {\r\n\t\t\t\tbtn.innerText = \"❌ Error\";\r\n\t\t\t}\r\n\r\n\t\t\tsetTimeout(() => {\r\n\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\tbtn.disabled = false;\r\n\t\t\t}, 4000);\r\n\t\t}\r\n\r\n\t\tasync function restartMass(btn) {\r\n\t\t\tif (!confirm(\"Are you sure you want to restart the Music Assistant container?\"))\r\n\t\t\t\treturn;\r\n\t\t\tconst orig = btn.innerText;\r\n\t\t\tbtn.innerText = \"Restarting...\";\r\n\t\t\tbtn.disabled = true;\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/api/admin/restart_ma', {\r\n\t\t\t\t\tmethod: 'POST'\r\n\t\t\t\t});\r\n\t\t\t\tconst data = await res.json();\r\n\t\t\t\tif (data.success) {\r\n\t\t\t\t\talert(\"Restart Command Sent!\");\r\n\t\t\t\t\tbtn.innerText = \"✅ Command Sent\";\r\n\t\t\t\t} else {\r\n\t\t\t\t\talert(\"Error: \" + (data.error || \"Unknown Error\"));\r\n\t\t\t\t\tbtn.innerText = \"❌ Failed\";\r\n\t\t\t\t}\r\n\t\t\t} catch (e) {\r\n\t\t\t\talert(\"Network Error: \" + e.message);\r\n\t\t\t\tbtn.innerText = \"❌ Error\";\r\n\t\t\t}\r\n\t\t\tsetTimeout(() => {\r\n\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\tbtn.disabled = false;\r\n\t\t\t}, 5000);\r\n\t\t}\r\n\r\n\t\t// NORMALIZED restartHybrid function\r\n\t\tasync function restartHybrid(btn) {\r\n\t\t\tconst forceInjectCheck = document.getElementById('forceInjectCheck');\r\n\t\t\tconst forceInjectSelect = document.getElementById('forceSpeakerSelect');\r\n\t\t\tconst forceRebootCheck = document.getElementById('forceRebootCheck');\r\n\t\t\tconst forceRebootSelect = document.getElementById('forceRebootSelect');\r\n\r\n\t\t\t// Evaluate both checkboxes and their targets\r\n\t\t\tconst isInject = forceInjectCheck ? forceInjectCheck.checked : false;\r\n\t\t\tconst injectTarget = isInject ? forceInjectSelect.value : null;\r\n\t\t\tconst isReboot = forceRebootCheck ? forceRebootCheck.checked : false;\r\n\t\t\tconst rebootTarget = isReboot ? forceRebootSelect.value : null;\r\n\r\n\t\t\tconst isForceMode = isInject || isReboot;\r\n\r\n\t\t\t// Dynamic warning text\r\n\t\t\tlet confirmMsg = \"Are you sure you want to restart the SoundTouch Hybrid application?\\n\\nThis will momentarily interrupt all audio streams.\";\r\n\t\t\tif (isForceMode) {\r\n\t\t\t\tconfirmMsg = `\uD83D\uDEA8 FORCE SEQUENCE ENABLED \uD83D\uDEA8\\n\\nAre you sure you want to force operations on the targeted speakers?\\n\\nThis will take longer than a standard restart.`;\r\n\t\t\t}\r\n\r\n\t\t\tif (!confirm(confirmMsg))\r\n\t\t\t\treturn;\r\n\r\n\t\t\tconst orig = btn.innerText;\r\n\t\t\tbtn.innerHTML = `<span class=\"spinner-border spinner-border-sm\" role=\"status\" aria-hidden=\"true\" style=\"margin-right: 5px;\"></span> ${isForceMode ? 'Executing...' : 'Restarting...'}`;\r\n\t\t\tbtn.disabled = true;\r\n\r\n\t\t\t// --- NORMALIZED ENDPOINT ---\r\n\t\t\tconst endpoint = '/api/admin/restart';\r\n\t\t\tconst payload = {\r\n\t\t\t\tinjectTarget: injectTarget,\r\n\t\t\t\trebootTarget: rebootTarget\r\n\t\t\t};\r\n\r\n\t\t\ttry {\r\n\t\t\t\tawait fetch(endpoint, {\r\n\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\theaders: {\r\n\t\t\t\t\t\t'Content-Type': 'application/json'\r\n\t\t\t\t\t},\r\n\t\t\t\t\tbody: JSON.stringify(payload)\r\n\t\t\t\t});\r\n\t\t\t\talert(isForceMode ? \"Force sequence initiated! Check server console.\" : \"Restart command sent!\");\r\n\t\t\t\tif (!isForceMode)\r\n\t\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\t\twindow.location.reload();\r\n\t\t\t\t\t}, 4000);\r\n\t\t\t} catch (e) {\r\n\t\t\t\talert(isForceMode ? \"Error executing sequence.\" : \"Server is rebooting.\");\r\n\t\t\t}\r\n\r\n\t\t\tif (isForceMode) {\r\n\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\t\tbtn.disabled = false;\r\n\t\t\t\t\tif (forceInjectCheck) {\r\n\t\t\t\t\t\tforceInjectCheck.checked = false;\r\n\t\t\t\t\t\tforceInjectSelect.disabled = true;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif (forceRebootCheck) {\r\n\t\t\t\t\t\tforceRebootCheck.checked = false;\r\n\t\t\t\t\t\tforceRebootSelect.disabled = true;\r\n\t\t\t\t\t}\r\n\t\t\t\t}, 5000);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tasync function triggerManualAudit() {\r\n\t\t\tif (!confirm(\"Execute a manual Speaker Preset Audit now? Any speakers missing their presets will be rebooted.\"))\r\n\t\t\t\treturn;\r\n\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/api/admin/force_audit', {\r\n\t\t\t\t\tmethod: 'POST'\r\n\t\t\t\t});\r\n\t\t\t\tif (res.ok) {\r\n\t\t\t\t\talert(\"✅ Speaker Audit initiated in the background. Check server logs for details.\");\r\n\t\t\t\t} else {\r\n\t\t\t\t\talert(\"❌ Server rejected the audit request.\");\r\n\t\t\t\t}\r\n\t\t\t} catch (e) {\r\n\t\t\t\talert(\"❌ Failed to reach the server: \" + e.message);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tasync function pushWifi(btn) {\r\n\t\t\tconst ip = document.getElementById('wifi-target').value;\r\n\t\t\tconst ssid = document.getElementById('wifi-ssid').value;\r\n\t\t\tconst pass = document.getElementById('wifi-pass').value;\r\n\r\n\t\t\tif (!ssid)\r\n\t\t\t\treturn alert(\"❌ Please enter a Network Name (SSID).\");\r\n\t\t\tif (!pass)\r\n\t\t\t\treturn alert(\"❌ Please enter the Wi-Fi Password.\");\r\n\r\n\t\t\tconst isUsb = (ip === \"203.0.113.1\" || ip === \"192.168.1.1\");\r\n\t\t\tconst orig = btn.innerText;\r\n\t\t\tbtn.innerText = \"Pushing...\";\r\n\t\t\tbtn.disabled = true;\r\n\r\n\t\t\ttry {\r\n\t\t\t\tif (isUsb) {\r\n\t\t\t\t\t// ==========================================\r\n\t\t\t\t\t// PATH A: USB SETUP (Custom Modal Preview)\r\n\t\t\t\t\t// ==========================================\r\n\r\n\t\t\t\t\tconst batContent = `@echo off\r\necho ===================++++++=====================\r\necho SoundTouch Hybrid USB Wi-Fi Provisioning Tool\r\necho ===================++++++=====================\r\necho Target Network: ${ssid}\r\necho.\r\necho Connecting to speaker via USB...\r\necho Provisioning can take a minute or so...\r\n\r\nREM --- Hunt down PowerShell automatically ---\r\nset \"PS_CMD=\"\r\nif exist \"%SystemRoot%\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" set \"PS_CMD=%SystemRoot%\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\"\r\nif exist \"%SystemRoot%\\\\SysWOW64\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" set \"PS_CMD=%SystemRoot%\\\\SysWOW64\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\"\r\nif exist \"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" set \"PS_CMD=C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\"\r\nif \"%PS_CMD%\"==\"\" set \"PS_CMD=powershell.exe\"\r\n\r\nREM --- Execute the payload with Error Handling and 12-second delay ---\r\n\"%PS_CMD%\" -NoProfile -ExecutionPolicy Bypass -Command \"try { $s=New-Object System.Net.Sockets.TcpClient('${ip}',17000); $st=$s.GetStream(); $w=New-Object System.IO.StreamWriter($st); $w.WriteLine('network wifi profiles clear'); $w.Flush(); Start-Sleep -s 3; $w.WriteLine('network wifi profiles add ${ssid} wpa_or_wpa2 ${pass}'); $w.Flush(); Start-Sleep -s 12; $w.WriteLine('sys reboot'); $w.Flush(); Start-Sleep -s 1; $w.Close(); $s.Close(); Write-Host ''; Write-Host '[SUCCESS] Commands sent successfully!'; Write-Host 'The speaker will now reboot.'; } catch { Write-Host ''; Write-Host '[ERROR] Could not connect to the speaker.'; Write-Host 'Please ensure the USB cable is plugged in and the Wi-Fi light is SOLID AMBER.'; Write-Host 'If the light is blinking, wait for it to stop before running this script.'; }\"\r\n\r\necho.\r\npause`;\r\n\r\n\t\t\t\t\t// 1. Inject the code into our custom modal and display it\r\n\t\t\t\t\tdocument.getElementById('scriptContent').innerText = batContent;\r\n\t\t\t\t\tdocument.getElementById('scriptModal').style.display = 'flex';\r\n\r\n\t\t\t\t\t// 2. Handle the 'Cancel' button click\r\n\t\t\t\t\tdocument.getElementById('cancelScriptBtn').onclick = function () {\r\n\t\t\t\t\t\tdocument.getElementById('scriptModal').style.display = 'none';\r\n\t\t\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\t\t\tbtn.disabled = false;\r\n\t\t\t\t\t};\r\n\r\n\t\t\t\t\t// 3. Handle the 'Download' button click\r\n\t\t\t\t\tdocument.getElementById('downloadScriptBtn').onclick = function () {\r\n\t\t\t\t\t\tdocument.getElementById('scriptModal').style.display = 'none';\r\n\r\n\t\t\t\t\t\t// Generate and download the file\r\n\t\t\t\t\t\tconst blob = new Blob([batContent], {\r\n\t\t\t\t\t\t\ttype: 'text/plain'\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\tconst url = window.URL.createObjectURL(blob);\r\n\t\t\t\t\t\tconst a = document.createElement('a');\r\n\t\t\t\t\t\ta.href = url;\r\n\t\t\t\t\t\ta.download = `Bose_USB_Setup_${ssid}.bat`;\r\n\t\t\t\t\t\tdocument.body.appendChild(a);\r\n\t\t\t\t\t\ta.click();\r\n\t\t\t\t\t\twindow.URL.revokeObjectURL(url);\r\n\t\t\t\t\t\tdocument.body.removeChild(a);\r\n\r\n\t\t\t\t\t\t// Show the final physical instructions\r\n\t\t\t\t\t\talert(\r\n\t\t\t\t\t\t\t\"\uD83D\uDCE5 Please run 'Bose_USB_Setup_\" + ssid + \".bat' from your Downloads folder.\\n\\n\" +\r\n\t\t\t\t\t\t\t\"When the script finishes, unplug the USB cable and wait for the speaker to finish rebooting.\\n\\n\" +\r\n\t\t\t\t\t\t\t\"Once the speaker is back online, refresh the Speaker Admin Page to confirm the connection.\");\r\n\r\n\t\t\t\t\t\tbtn.innerText = \"✅ Downloaded\";\r\n\t\t\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\t\t\t\tbtn.disabled = false;\r\n\t\t\t\t\t\t}, 4000);\r\n\t\t\t\t\t};\r\n\t\t\t\t\t// We return here so the main function stops and waits for the user's click\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} else {\r\n\t\t\t\t\t// ==========================================\r\n\t\t\t\t\t// PATH B: NETWORK SWITCH (Via HOST NAS)\r\n\t\t\t\t\t// ==========================================\r\n\t\t\t\t\t// 1. universal confirmation message\r\n\t\t\t\t\tconst confirmMsg = `Are you sure you want to push these Wi-Fi settings to ${ip}?\\n\\nThe speaker will delete its current network, save the new one, and reboot.\\n\\n)`;\r\n\r\n\t\t\t\t\tif (!confirm(confirmMsg)) {\r\n\t\t\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\t\t\tbtn.disabled = false;\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t// 2. Send the command!\r\n\t\t\t\t\tconst res = await fetch('/api/admin/set_wifi', {\r\n\t\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\t\theaders: {\r\n\t\t\t\t\t\t\t'Content-Type': 'application/json'\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\tbody: JSON.stringify({\r\n\t\t\t\t\t\t\tip,\r\n\t\t\t\t\t\t\tssid,\r\n\t\t\t\t\t\t\tpassword: pass\r\n\t\t\t\t\t\t})\r\n\t\t\t\t\t});\r\n\r\n\t\t\t\t\tconst data = await res.json();\r\n\r\n\t\t\t\t\tif (data.success) {\r\n\t\t\t\t\t\talert(\"✅ Network Switch complete!\\n\\nThe speaker is rebooting to connect to the new network.\\n\\n⚠\uFE0F IMPORTANT: If it fails to connect, you will have to use the USB Setup Cable approach to rescue it.\");\r\n\t\t\t\t\t\tbtn.innerText = \"✅ Sent\";\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\talert(\"❌ Error: \" + (data.error || \"Failed to push Wi-Fi.\"));\r\n\t\t\t\t\t\tbtn.innerText = \"❌ Failed\";\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t} catch (e) {\r\n\t\t\t\talert(\"❌ Network Error: \" + e.message);\r\n\t\t\t\tbtn.innerText = \"❌ Error\";\r\n\t\t\t}\r\n\r\n\t\t\tsetTimeout(() => {\r\n\t\t\t\tbtn.innerText = orig;\r\n\t\t\t\tbtn.disabled = false;\r\n\t\t\t}, 4000);\r\n\t\t}\r\n\r\n\t\t// --- FETCH SYSTEM VERSIONS ---\r\n\t\tdocument.addEventListener('DOMContentLoaded', async() => {\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/api/admin/system_versions');\r\n\t\t\t\tif (res.ok) {\r\n\t\t\t\t\tconst versions = await res.json();\r\n\t\t\t\t\tdocument.getElementById('badge-app-text').innerText = `${versions.app}`;\r\n\t\t\t\t\tdocument.getElementById('badge-mass-text').innerText = `v${versions.mass}`;\r\n\t\t\t\t\tdocument.getElementById('tz-display').innerText = `TZ: ${versions.timezone}`;\r\n\t\t\t\t}\r\n\t\t\t} catch (e) {\r\n\t\t\t\tconsole.error(\"[UI] Failed to load system versions: \", e);\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\t// ==========================================\r\n\t\t// ST10 STEREO PAIRING UI LOGIC\r\n\t\t// ==========================================\r\n\t\tlet st10Speakers = [];\r\n\t\tlet activePairs = []; // Track saved pairs to disable them in dropdowns\r\n\r\n\t\tfunction initStereoUI(devices) {\r\n\t\t\tst10Speakers = devices.filter(s => s.type === 'SoundTouch 10');\r\n\r\n\t\t\t// --- INJECT DUMMIES FOR TESTING ---\r\n\t\t\tst10Speakers.push({\r\n\t\t\t\tip: \"10.0.0.91\",\r\n\t\t\t\tname: \"Dummy ST10 (Alpha)\",\r\n\t\t\t\ttype: \"SoundTouch 10\"\r\n\t\t\t});\r\n\r\n\t\t\tfetchStereoPairs();\r\n\t\t}\r\n\r\n\t\tfunction populateStereoDropdowns() {\r\n\t\t\tconst leftSelect = document.getElementById('leftSpeakerSelect');\r\n\t\t\tconst rightSelect = document.getElementById('rightSpeakerSelect');\r\n\t\t\tif (!leftSelect || !rightSelect)\r\n\t\t\t\treturn;\r\n\r\n\t\t\tconst leftVal = leftSelect.value;\r\n\t\t\tconst rightVal = rightSelect.value;\r\n\r\n\t\t\tleftSelect.innerHTML = '<option value=\"\" disabled selected>Select Left ST10...</option>';\r\n\t\t\trightSelect.innerHTML = '<option value=\"\" disabled selected>Select Right ST10...</option>';\r\n\r\n\t\t\t// Build a quick lookup of IPs that are already in a saved pair\r\n\t\t\tconst pairedIps = new Set();\r\n\t\t\tactivePairs.forEach(p => {\r\n\t\t\t\tpairedIps.add(p.leftIp);\r\n\t\t\t\tpairedIps.add(p.rightIp);\r\n\t\t\t});\r\n\r\n\t\t\tst10Speakers.forEach(spk => {\r\n\t\t\t\tconst isAlreadyPaired = pairedIps.has(spk.ip);\r\n\r\n\t\t\t\t// \uD83C\uDF1F THE FIX: Use originalName if available, fallback to regular name\r\n\t\t\t\tconst displayName = spk.originalName || spk.name;\r\n\r\n\t\t\t\t// Build Left Option\r\n\t\t\t\tconst optLeft = new Option(displayName, spk.ip);\r\n\t\t\t\tif (isAlreadyPaired || spk.ip === rightVal) {\r\n\t\t\t\t\toptLeft.disabled = true;\r\n\t\t\t\t\toptLeft.style.color = 'var(--text-secondary)';\r\n\t\t\t\t\toptLeft.style.fontStyle = 'italic';\r\n\t\t\t\t\tif (isAlreadyPaired)\r\n\t\t\t\t\t\toptLeft.text += ' (Already Paired)';\r\n\t\t\t\t}\r\n\t\t\t\tleftSelect.add(optLeft);\r\n\r\n\t\t\t\t// Build Right Option\r\n\t\t\t\tconst optRight = new Option(displayName, spk.ip);\r\n\t\t\t\tif (isAlreadyPaired || spk.ip === leftVal) {\r\n\t\t\t\t\toptRight.disabled = true;\r\n\t\t\t\t\toptRight.style.color = 'var(--text-secondary)';\r\n\t\t\t\t\toptRight.style.fontStyle = 'italic';\r\n\t\t\t\t\tif (isAlreadyPaired)\r\n\t\t\t\t\t\toptRight.text += ' (Already Paired)';\r\n\t\t\t\t}\r\n\t\t\t\trightSelect.add(optRight);\r\n\t\t\t});\r\n\r\n\t\t\tleftSelect.value = leftVal || '';\r\n\t\t\trightSelect.value = rightVal || '';\r\n\t\t}\r\n\r\n\t\tdocument.getElementById('leftSpeakerSelect')?.addEventListener('change', populateStereoDropdowns);\r\n\t\tdocument.getElementById('rightSpeakerSelect')?.addEventListener('change', populateStereoDropdowns);\r\n\r\n\r\n\t\tasync function fetchStereoPairs() {\r\n\t\t\ttry {\r\n\t\t\t\t//  Added /admin\r\n\t\t\t\tconst res = await fetch('/api/admin/stereo-pairs');\r\n\t\t\t\tif (!res.ok) return;\r\n\t\t\t\tconst pairs = await res.json();\r\n\t\t\t\trenderStereoPairs(pairs);\r\n\t\t\t\tpopulateStereoDropdowns(); // Re-disables IPs\r\n\t\t\t} catch (e) {}\r\n\t\t}\r\n\r\n\t\tfunction renderStereoPairs(pairs) {\r\n\t\t\tconst list = document.getElementById('activeStereoPairsList');\r\n\t\t\tactivePairs = pairs; // \uD83C\uDF1F FIX: Ensure the global tracking array stays updated\r\n\t\t\tdocument.getElementById('stereoPairCount').innerText = `${pairs.length} Pairs`;\r\n\r\n\t\t\tif (pairs.length === 0) {\r\n\t\t\t\tlist.innerHTML = '<li class=\"no-active-pairs-li-element\">No active pairings found.</li>';\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\t// \uD83C\uDF1F FIX: Helper function to look up the real hardware name by IP\r\n\t\t\tconst getRealName = (ip) => {\r\n\t\t\t\tconst spk = st10Speakers.find(s => s.ip === ip);\r\n\t\t\t\treturn spk ? (spk.originalName || spk.name) : ip;\r\n\t\t\t};\r\n\r\n\t\t\tlist.innerHTML = pairs.map(p => `\r\n\t\t\t\t<li class=\"active-pairs-li-element\">\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<strong>${p.name}</strong><br>\r\n\t\t\t\t\t\t<small>Left: ${getRealName(p.leftIp)} | Right: ${getRealName(p.rightIp)}</small>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<button class=\"btn-sm\" onclick=\"deleteStereoPair('${p.id}', '${p.leftIp}', '${p.rightIp}')\">\r\n\t\t\t\t\t\t\uD83D\uDDD1\uFE0F Delete\r\n\t\t\t\t\t</button>\r\n\t\t\t\t</li>\r\n\t\t\t`).join('');\r\n\t\t}\r\n\r\n\t\tdocument.getElementById('saveStereoPairBtn')?.addEventListener('click', async() => {\r\n\t\t\tconst leftSelect = document.getElementById('leftSpeakerSelect');\r\n\t\t\tconst rightSelect = document.getElementById('rightSpeakerSelect');\r\n\t\t\tconst nameInput = document.getElementById('pairNameInput');\r\n\r\n\t\t\tconst leftIp = leftSelect.value;\r\n\t\t\tconst rightIp = rightSelect.value;\r\n\t\t\tconst name = nameInput.value.trim();\r\n\r\n\t\t\tif (!leftIp || !rightIp || !name)\r\n\t\t\t\treturn alert(\"Select both speakers and provide a name.\");\r\n\r\n\t\t\tif (!confirm(`Save \"${name}\" as a stereo pair?\\n\\nThis will reboot BOTH speakers to apply the left/right audio separation.`)) \r\n\t\t\t\treturn;\r\n\r\n\t\t\tconst btn = document.getElementById('saveStereoPairBtn');\r\n\t\t\tconst origText = btn.innerHTML;\r\n\t\t\tbtn.innerHTML = `⏳ Saving...`;\r\n\t\t\tbtn.disabled = true;\r\n\r\n\t\t\ttry {\r\n\t\t\t\t// FIXED PATH: Added /admin\r\n\t\t\t\tconst res = await fetch('/api/admin/stereo-pairs', {\r\n\t\t\t\t\tmethod: 'POST',\r\n\t\t\t\t\theaders: { 'Content-Type': 'application/json' },\r\n\t\t\t\t\tbody: JSON.stringify({ leftIp, rightIp, name })\r\n\t\t\t\t});\r\n\r\n\t\t\t\tif (res.ok) {\r\n\r\n\t\t\t\t// \uD83C\uDF1F AUTOMATED TARGETED REBOOTS (Ignores 10.0.0.9x Dummies)\r\n\t\t\t\tif (!leftIp.startsWith('10.0.0.9')) {\r\n\t\t\t\t\tfetch('/api/admin/reboot_speaker', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ ip: leftIp }) });\r\n\t\t\t\t}\r\n\t\t\t\tif (!rightIp.startsWith('10.0.0.9')) {\r\n\t\t\t\t\tfetch('/api/admin/reboot_speaker', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ ip: rightIp }) });\r\n\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\talert(\"✅ Pair saved! Reboot Commands sent to both speakers.\\n\\nThe network providers will aggressively reload in 90 seconds.\");\r\n\r\n\t\t\t\t\tnameInput.value = '';\r\n\t\t\t\t\tleftSelect.value = '';\r\n\t\t\t\t\trightSelect.value = '';\r\n\t\t\t\t\tfetchStereoPairs();\r\n\t\t\t\t} else {\r\n\t\t\t\t\talert(\"❌ Failed to save pairing to the server.\");\r\n\t\t\t\t}\r\n\t\t\t} catch (e) {\r\n\t\t\t\talert(\"❌ Network Error: Could not reach the server.\");\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tbtn.innerHTML = origText;\r\n\t\t\tbtn.disabled = false;\r\n\t\t});\r\n\r\n\t\tasync function deleteStereoPair(id, leftIp, rightIp) {\r\n\t\t\tif (!confirm(\"Are you sure you want to delete this stereo pair?\\n\\nThis will reboot BOTH speakers to clear their stereo roles.\")) \r\n\t\t\t\treturn;\r\n\r\n\t\t\ttry {\r\n\t\t\t\t// FIXED PATH: Added /admin\r\n\t\t\t\tawait fetch(`/api/admin/stereo-pairs/${id}`, { method: 'DELETE' });\r\n\t\t\t\t\r\n\t\t\t\t// \uD83C\uDF1F AUTOMATED TARGETED REBOOTS (Ignores 10.0.0.9x Dummies)\r\n\t\t\t\tif (!leftIp.startsWith('10.0.0.9')) {\r\n\t\t\t\t\tfetch('/api/admin/reboot_speaker', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ ip: leftIp }) });\r\n\t\t\t\t}\r\n\t\t\t\tif (!rightIp.startsWith('10.0.0.9')) {\r\n\t\t\t\t\tfetch('/api/admin/reboot_speaker', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ ip: rightIp }) });\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\talert(\"✅ Pair deleted! Telnet Reboot Commands sent to both speakers.\\n\\nThey will return to standalone mode shortly.\");\r\n\t\t\t\tfetchStereoPairs();\r\n\t\t\t} catch (e) {\r\n\t\t\t\talert(\"❌ Error deleting pair.\");\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// ==========================================\r\n\t\t// FINAL EXECUTION COMMANDS\r\n\t\t// ==========================================\r\n\t\tdocument.addEventListener('DOMContentLoaded', () => {\r\n\t\t\tloadTools();\r\n\t\t});\r\n\t</script>\r\n</body>\r\n</html>

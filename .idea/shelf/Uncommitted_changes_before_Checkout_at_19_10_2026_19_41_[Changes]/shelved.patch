o;\r\n    -ms-overflow-style: none;  /* Internet Explorer 10+ */\r\n    scrollbar-width: none;  /* Firefox, Safari 18.2+, Chromium 121+ */\r\n\r\n    &::-webkit-scrollbar { \r\n      display: none;  /* Older Safari and Chromium */\r\n    }\r\n  }\r\n\r\n  @starting-style {\r\n    :open::picker(select) {\r\n      margin-top: 0;\r\n      height: 0;\r\n      overflow-y: hidden;\r\n      opacity: 0;\r\n      -ms-overflow-style: none;  /* Internet Explorer 10+ */\r\n      scrollbar-width: none;  /* Firefox, Safari 18.2+, Chromium 121+ */\r\n\r\n      &::-webkit-scrollbar { \r\n        display: none;  /* Older Safari and Chromium */\r\n      }\r\n    }\r\n  }\r\n\r\n  ::picker(select) {\r\n    appearance: base-select;\r\n    border-radius: 12px;\r\n    border: 2px solid #888;\r\n    margin-top: 0;\r\n    height: 0;\r\n    opacity: 0;\r\n    overflow-y: hidden;\r\n    background: var(--card);\r\n    backdrop-filter: blur(5px);\r\n    box-shadow: 0px 0px 5px 1px var(--bg);\r\n    transition: all .2s ease-in-out allow-discrete;\r\n    -ms-overflow-style: none;  /* Internet Explorer 10+ */\r\n    scrollbar-width: none;  /* Firefox, Safari 18.2+, Chromium 121+ */\r\n\r\n    &::-webkit-scrollbar { \r\n      display: none;  /* Older Safari and Chromium */\r\n    }\r\n  }\r\n}\r\n\r\n\r\n\r\nselect[data-master-select] {\r\n  appearance: base-select;\r\n  /* Crucial resets so the browser doesn't warp your layout */\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n\r\n  height: 100%;\r\n  padding: 0 12px;\r\n\r\n  border: 1px solid var(--btn-border);\r\n\r\n  border-radius: 6px;\r\n  margin: 0;\r\n  font-family: inherit;\r\n  font-size: 0.85em;\r\n\r\n  font-weight: bold;\r\n\r\n  color: var(--btn-text);\r\n  background: var(--btn-bg);\r\n\r\n  outline: none;\r\n\r\n  &::picker-icon {\r\n    transition: all .2s ;\r\n  }\r\n\r\n  &:open::picker-icon{\r\n    transform: rotate(180deg);\r\n  }\r\n\r\n  &:hover {\r\n    border-color: #888;\r\n    background: var(--btn-hover-bg);\r\n    color: var(--text);\r\n  }\r\n\r\n  &:active,\r\n  &:focus {\r\n    border-color: var(--accent);\r\n\r\n    color: var(--text);\r\n\r\n    outline: 2px solid var(--accent);\r\n  }\r\n\r\n\r\n  option {\r\n    display: flex;\r\n    justify-content: flex-start;\r\n    gap: 20px;\r\n    margin: 5px;\r\n    border: 1px solid var(--btn-border);\r\n    background: var(--bg-transparent);\r\n    color: var(--btn-text);\r\n    padding: 10px;\r\n    transition: 0.4s;\r\n    border-radius: 8px;\r\n\r\n    &:hover {\r\n      background-color: var(--btn-hover-bg);\r\n      color: var(--text);\r\n      border: 1px solid #888;\r\n    }\r\n\r\n    &:first-of-type {\r\n      border-radius: 8px;\r\n      opacity: .6;\r\n    }\r\n\r\n    &::checkmark {\r\n      display: none;\r\n    }\r\n\r\n    &:checked {\r\n      font-weight: bold;\r\n      color: var(--text);\r\n      border: 1px solid var(--accent);\r\n      background-color: rgba(46, 204, 113, 0.1);\r\n    }\r\n\r\n\r\n    &:active {\r\n      border-color: var(--accent);\r\n\r\n      color: var(--text);\r\n\r\n      outline: 1px solid var(--accent);\r\n      \r\n    }\r\n\r\n\r\n  }\r\n}\r\n\r\n\r\n\r\n.custom-dropdown-wrapper {\r\n  position: relative;\r\n  z-index: 0;\r\n  display: block;\r\n  grid-column: span 5;\r\n\r\n  &:has(select:disabled) {\r\n    cursor: not-allowed;\r\n  }\r\n\r\n/*  &::after {\r\n    content: \"▼\";\r\n    position: absolute;\r\n    top: 50%;\r\n    right: 15px;\r\n    z-index: 1;\r\n    transform: translateY(-50%) rotateZ(0deg);\r\n    transition: all .2s ease-in-out;\r\n    pointer-events: none;\r\n  }\r\n  &:has(select[data-master-select]:open) {\r\n    &::after {\r\n      transform: translateY(-50%) rotateZ(180deg);\r\n    }\r\n    }*/\r\n  }\r\n\r\nselect[data-master-select]::-ms-expand {\r\n  display: none;\r\n}\r\n\r\n\r\n.master-badge {\r\n  padding: 8px;\r\n\r\n  border: 1px solid rgba(155, 89, 182, 0.3);\r\n\r\n  border-radius: 4px;\r\n  font-size: 0.8em;\r\n\r\n  font-weight: bold;\r\n  letter-spacing: 0.5px;\r\n\r\n  text-align: center;\r\n  text-transform: uppercase;\r\n\r\n  color: var(--group);\r\n  background: rgba(155, 89, 182, 0.15);\r\n  grid-column: span 4;\r\n}\r\n\r\n.slider-container {\r\n  position: relative;\r\n\r\n  display: flex;\r\n\r\n  flex-direction: row;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.slider-text {\r\n  width: 30px;\r\n\r\n  font-size: 0.8em;\r\n\r\n  text-align: right;\r\n\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.group-label {\r\n  margin-top: 10px;\r\n  margin-bottom: 5px;\r\n  font-size: 0.7em;\r\n\r\n  font-weight: bold;\r\n\r\n  text-transform: uppercase;\r\n\r\n  color: var(--group);\r\n}\r\n\r\n/* --- FLOATING VOLUME BUBBLE --- */\r\n\r\n.vol-bubble {\r\n  position: absolute;\r\n  top: -50px;\r\n\r\n  /* Floats above the slider */\r\n  padding: 4px 8px;\r\n\r\n  border-radius: 4px;\r\n  font-size: 0.8em;\r\n\r\n  font-weight: bold;\r\n\r\n  color: #000;\r\n  background: var(--accent);\r\n\r\n  pointer-events: none;\r\n\r\n  /* Let clicks pass through */\r\n  opacity: 0;\r\n\r\n  /* Hidden by default */\r\n  transform: translateX(-50%);\r\n\r\n  /* Centers bubble on the handle */\r\n  z-index: 100;\r\n\r\n  white-space: nowrap;\r\n\r\n  box-shadow: 0 2px 5px rgba(0,0,0,0.5);\r\n\r\n  transition: none;\r\n  /* SNAPPY: No fading; */\r\n}\r\n\r\n/* Show bubble when active */\r\n\r\n.vol-bubble.visible {\r\n  opacity: 1;\r\n\r\n  -webkit-transform: translateX(-50%) scale(2.0);\r\n\r\n  /* iPhone specific */\r\n  transform: translateX(-50%) scale(2.0);\r\n}\r\n\r\n/* Triangle pointer at bottom of bubble */\r\n\r\n.vol-bubble::after {\r\n  content: '';\r\n  position: absolute;\r\n  bottom: -4px;\r\n  left: 50%;\r\n\r\n  border-width: 4px;\r\n  border-style: solid;\r\n  border-color: var(--accent) transparent transparent transparent;\r\n\r\n  margin-left: -4px;\r\n}\r\n\r\n.grid {\r\n  grid-template-columns: 1fr;\r\n\r\n  padding-bottom: 60px;\r\n}\r\n\r\n/* =========================================\r\n   8. STATE MACHINE VISUALS (CORRECTED)\r\n   ========================================= */\r\n/* 1. GREEN (Active/Playing) - Play Button & Active Preset */\r\n\r\n.btn-active,\r\n.active-locked {\r\n  border-color: var(--accent);\r\n\r\n  color: var(--accent);\r\n  background-color: rgba(46, 204, 113, 0.2);\r\n\r\n  opacity: 1;\r\n\r\n  cursor: pointer;\r\n}\r\n\r\n/* 2. YELLOW (Pending/Transition) - Pause, Seek, Loading */\r\n\r\n.btn-pending,\r\n.btn-pending:hover,\r\n.btn-pending:disabled {\r\n  border-color: var(--pending);\r\n\r\n  color: var(--pending);\r\n  background-color: rgba(241, 196, 15, 0.15);\r\n\r\n  cursor: wait;\r\n  pointer-events: auto;\r\n}\r\n\r\n/* 4. DISABLED (Locked) */\r\n\r\n.btn-disabled:not(.btn-pending) {\r\n  cursor: default;\r\n  pointer-events: none;\r\n}\r\n\r\n/* 5. MASTER JOIN (Purple) */\r\n\r\n.btn-master-join,\r\n.btn-master-join:hover {\r\n  border-color: var(--group);\r\n\r\n  color: var(--group);\r\n  background-color: rgba(155, 89, 182, 0.2);\r\n\r\n  cursor: default;\r\n}\r\n\r\n/* 6. BLANK ART (Placeholder) - FIX: Uses Theme Variable */\r\n\r\n.art-blank {\r\n  display: flex;\r\n\r\n  justify-content: center;\r\n  align-items: center;\r\n\r\n  border: 1px solid var(--border);\r\n\r\n  background-color: var(--art-bg);\r\n}\r\n\r\n.art-blank::after {\r\n  content: \"\uD83C\uDFB5\";\r\n\r\n  color: var(--text);\r\n\r\n  opacity: 0.3;\r\n  /* NOTICE: font-size was removed from here!; */\r\n}\r\n
